section \<open>The subring generated by a set\<close>

theory Subring_Generated
  imports Ring_Theory
begin

text \<open>Mirroring the subgroup \<open>generate\<close> and the ideal generated by a set, the subring generated by
  a subset \<open>S\<close> of a ring is the intersection of all subrings containing \<open>S \<inter> R\<close>.  We first show
  that an intersection of a nonempty family of subrings is a subring; the whole ring is a subring
  of itself, so the family intersected is always nonempty.\<close>

context Ring
begin

subsection \<open>Intersections of subrings\<close>

text \<open>The intersection of a nonempty family of subrings is a subring.\<close>
lemma subring_Inter:
  assumes ne: "\<A> \<noteq> {}" and sr: "\<And>S. S \<in> \<A> \<Longrightarrow> Subring S R (+) (\<cdot>) \<zero> \<one>"
  shows "Subring (\<Inter> \<A>) R (+) (\<cdot>) \<zero> \<one>"
proof -
  obtain S0 where S0: "S0 \<in> \<A>" using ne by blast
  interpret S0: Subring S0 R "(+)" "(\<cdot>)" \<zero> \<one> by (rule sr[OF S0])
  \<comment> \<open>The additive part is a subgroup.\<close>
  have sg: "Subgroup (\<Inter> \<A>) R (+) \<zero>"
  proof (rule additive.subgroupI)
    show "\<Inter> \<A> \<subseteq> R" using S0 S0.additive.subset by blast
  next
    show "\<zero> \<in> \<Inter> \<A>"
    proof
      fix S assume "S \<in> \<A>"
      then interpret S: Subring S R "(+)" "(\<cdot>)" \<zero> \<one> by (rule sr)
      show "\<zero> \<in> S" by (rule S.additive.sub_unit_closed)
    qed
  next
    fix g h assume g: "g \<in> \<Inter> \<A>" and h: "h \<in> \<Inter> \<A>"
    show "g + h \<in> \<Inter> \<A>"
    proof
      fix S assume S: "S \<in> \<A>"
      then interpret S: Subring S R "(+)" "(\<cdot>)" \<zero> \<one> by (rule sr)
      show "g + h \<in> S" using g h S by (blast intro: S.additive.sub_composition_closed)
    qed
  next
    fix g assume "g \<in> \<Inter> \<A>"
    then have "g \<in> R" using S0 S0.additive.subset by blast
    then show "additive.invertible g" by simp
  next
    fix g assume g: "g \<in> \<Inter> \<A>"
    show "additive.inverse g \<in> \<Inter> \<A>"
    proof
      fix S assume S: "S \<in> \<A>"
      then interpret S: Subring S R "(+)" "(\<cdot>)" \<zero> \<one> by (rule sr)
      have "g \<in> S" using g S by blast
      then show "additive.inverse g \<in> S"
        using S.additive.submonoid_inverse_closed S.additive.sub.invertible by blast
    qed
  qed
  \<comment> \<open>The multiplicative part is a submonoid.\<close>
  interpret sg: Subgroup "\<Inter> \<A>" R "(+)" \<zero> by (rule sg)
  show ?thesis
  proof
    show "\<Inter> \<A> \<subseteq> R" using sg.subset .
    show "\<one> \<in> \<Inter> \<A>"
    proof
      fix S assume "S \<in> \<A>"
      then interpret S: Subring S R "(+)" "(\<cdot>)" \<zero> \<one> by (rule sr)
      show "\<one> \<in> S" by (rule S.multiplicative.sub_unit_closed)
    qed
    fix a b assume a: "a \<in> \<Inter> \<A>" and b: "b \<in> \<Inter> \<A>"
    show "a \<cdot> b \<in> \<Inter> \<A>"
    proof
      fix S assume S: "S \<in> \<A>"
      then interpret S: Subring S R "(+)" "(\<cdot>)" \<zero> \<one> by (rule sr)
      show "a \<cdot> b \<in> S" using a b S by (blast intro: S.multiplicative.sub_composition_closed)
    qed
  qed
qed


text \<open>The whole ring is a subring of itself (the top subring).\<close>
lemma whole_subring: "Subring R R (+) (\<cdot>) \<zero> \<one>"
proof -
  have "Subgroup R R (+) \<zero>" by (rule additive.subgroupI) auto
  then interpret sg: Subgroup R R "(+)" \<zero> .
  show ?thesis by unfold_locales auto
qed


subsection \<open>The generated subring\<close>

text \<open>The subring generated by a subset \<open>S\<close>: the intersection of all subrings containing
  \<open>S \<inter> R\<close> (intersecting with \<open>R\<close> in the guard, as with subgroups and ideals, so that elements
  outside the carrier are ignored).\<close>
definition subring_generated :: "'a set \<Rightarrow> 'a set"
  where "subring_generated S = \<Inter> {T. Subring T R (+) (\<cdot>) \<zero> \<one> \<and> S \<inter> R \<subseteq> T}"

lemma subring_generated_is_subring: "Subring (subring_generated S) R (+) (\<cdot>) \<zero> \<one>"
proof -
  have "R \<in> {T. Subring T R (+) (\<cdot>) \<zero> \<one> \<and> S \<inter> R \<subseteq> T}" using whole_subring by auto
  then have ne: "{T. Subring T R (+) (\<cdot>) \<zero> \<one> \<and> S \<inter> R \<subseteq> T} \<noteq> {}" by blast
  show ?thesis
    unfolding subring_generated_def by (rule subring_Inter[OF ne]) auto
qed

lemma subring_generated_incl: "S \<inter> R \<subseteq> subring_generated S"
  unfolding subring_generated_def by blast

lemma subring_generated_minimal:
  assumes "Subring T R (+) (\<cdot>) \<zero> \<one>" "S \<inter> R \<subseteq> T"
  shows "subring_generated S \<subseteq> T"
  unfolding subring_generated_def using assms by (blast intro: Inter_lower)

lemma subring_generated_subset_carrier: "subring_generated S \<subseteq> R"
proof -
  interpret gen: Subring "subring_generated S" R "(+)" "(\<cdot>)" \<zero> \<one>
    by (rule subring_generated_is_subring)
  show ?thesis by (rule gen.additive.subset)
qed

end

end
