section \<open>Extensions of a Field inside the Indexed Polynomial Ring\<close>

theory Closure_Extension
  imports Indexed_Poly Poly_Divisibility_Bridge "HOL.Zorn"
begin

text \<open>
  Groundwork for the existence of an algebraic closure.  Every extension needed for that is
  generated by adjoining roots of polynomials over the base field \<open>R\<close>, so all of them can be built
  inside \<^emph>\<open>one\<close> fixed type: the indexed polynomials of \<open>Indexed_Poly\<close> whose indeterminates are
  indexed by pairs \<open>(P, i)\<close> --- a polynomial over \<open>R\<close> together with a natural number, so that each
  polynomial has as many indeterminates available as it could have roots.

  Fixing the type in advance is what makes Zorn's lemma applicable: the extensions then form a
  \<^emph>\<open>set\<close>, which can be ordered and exhausted.  The alternative, iterating a quotient construction to
  adjoin one root at a time, changes the type at every step --- a quotient of a ring over \<^typ>\<open>'a\<close>
  has carrier of type \<^typ>\<open>'a set\<close> --- and so cannot be iterated by induction at all.

  An extension is a triple \<open>(K, \<oplus>, \<otimes>)\<close>: a carrier with its own addition and multiplication.  The
  operations must be allowed to vary, because an extension realises a quotient \<open>M[X]/(Q)\<close>
  concretely, by normal forms, and the modulus \<open>Q\<close> differs from step to step.  The zero and the
  unit, by contrast, are the same throughout: the constants \<open>\<zero>\<^sub>I\<close> and \<open>\<one>\<^sub>I\<close>.

  \<^bold>\<open>Why the operations are required to be undefined off the carrier.\<close>  Two extensions with the same
  carrier and the same operations \<^emph>\<open>on\<close> that carrier are the same extension mathematically, but need
  not be equal as triples if the operations disagree elsewhere --- and then the ordering below fails
  antisymmetry, so it is not a partial order and Zorn does not apply.  HOL-Algebra repairs this after
  the fact with a \<open>law_restrict\<close> operator and a family of lemmas transporting field-ness,
  homomorphisms and isomorphisms across it.  Here it is part of what an extension is, which costs one
  condition and no lemmas: in the carrier-set architecture the operations are parameters that can be
  constrained, rather than record fields that are total by construction.
\<close>

type_synonym 'a root_index = "(nat \<Rightarrow> 'a) \<times> nat"
type_synonym 'a ipoly = "'a root_index multiset \<Rightarrow> 'a"
type_synonym 'a iop = "'a ipoly \<Rightarrow> 'a ipoly \<Rightarrow> 'a ipoly"
type_synonym 'a iext = "'a ipoly set \<times> 'a iop \<times> 'a iop"

abbreviation ecarrier :: "'a iext \<Rightarrow> 'a ipoly set" where "ecarrier E \<equiv> fst E"
abbreviation eadd :: "'a iext \<Rightarrow> 'a iop" where "eadd E \<equiv> fst (snd E)"
abbreviation emult :: "'a iext \<Rightarrow> 'a iop" where "emult E \<equiv> snd (snd E)"

subsection \<open>Operations defined only on their carrier\<close>

text \<open>An operation is \<^emph>\<open>restricted\<close> to @{term K} when it is @{const undefined} unless both arguments
  lie in @{term K}.  This is the condition discussed above; the lemma after it is the only thing the
  condition is ever used for, and replaces HOL-Algebra's \<open>law_restrict\<close> apparatus.\<close>
definition op_restricted :: "'a ipoly set \<Rightarrow> 'a iop \<Rightarrow> bool"
  where "op_restricted K f \<longleftrightarrow> (\<forall>x y. (x \<notin> K \<or> y \<notin> K) \<longrightarrow> f x y = undefined)"

lemma op_restrictedI:
  "(\<And>x y. x \<notin> K \<or> y \<notin> K \<Longrightarrow> f x y = undefined) \<Longrightarrow> op_restricted K f"
  by (simp add: op_restricted_def)

lemma op_restrictedD:
  "\<lbrakk> op_restricted K f; x \<notin> K \<or> y \<notin> K \<rbrakk> \<Longrightarrow> f x y = undefined"
  by (simp add: op_restricted_def)

text \<open>Two operations restricted to the same carrier and agreeing on it are equal.\<close>
lemma restricted_op_eqI:
  assumes f: "op_restricted K f" and g: "op_restricted K g"
    and eq: "\<And>x y. \<lbrakk> x \<in> K; y \<in> K \<rbrakk> \<Longrightarrow> f x y = g x y"
  shows "f = g"
  \<comment> \<open>Two applications of @{thm [source] ext}, not @{method intro}: the result type \<^typ>\<open>'a ipoly\<close>
      is itself a function type, so a greedy @{method intro} strips a third argument.\<close>
proof (rule ext, rule ext)
  fix x y
  show "f x y = g x y"
  proof (cases "x \<in> K \<and> y \<in> K")
    case True then show ?thesis using eq by simp
  next
    case False
    then have "x \<notin> K \<or> y \<notin> K" by blast
    then show ?thesis using op_restrictedD [OF f] op_restrictedD [OF g] by simp
  qed
qed


context Ring
begin

subsection \<open>Lifted polynomials\<close>

text \<open>A polynomial over @{term R} read as a polynomial over the ambient ring, coefficientwise.
  Where HOL-Algebra maps a coefficient \<^emph>\<open>list\<close> through its constant embedding, a polynomial here is
  already a function on exponents, so the lift is a composition.\<close>
definition lift_poly :: "(nat \<Rightarrow> 'a) \<Rightarrow> (nat \<Rightarrow> 'a ipoly)"
  where "lift_poly P = (\<lambda>k. ipoly_const (P k))"

lemma lift_poly_apply [simp]: "lift_poly P k = ipoly_const (P k)"
  by (simp add: lift_poly_def)

lemma lift_poly_coeff_closed: "P \<in> poly_carrier \<Longrightarrow> lift_poly P k \<in> ipoly_carrier"
  by (simp add: ipoly_const_closed poly_carrier_coeff_closed)


subsection \<open>What it is to be an extension\<close>

text \<open>Evaluation in an extension, at that extension's own operations.\<close>
abbreviation eeval :: "'a iext \<Rightarrow> 'a ipoly \<Rightarrow> (nat \<Rightarrow> 'a ipoly) \<Rightarrow> 'a ipoly"
  where "eeval E \<equiv> Ring.eval (ecarrier E) (eadd E) (emult E) \<zero>\<^sub>I \<one>\<^sub>I"

text \<open>Evaluation in the \<^emph>\<open>ambient\<close> indexed polynomial ring.  A locale prefix is not available here:
  we are inside @{locale Ring} already, and interpreting the indexed polynomial ring as a
  @{locale Ring} at this point would be self-referential.  An abbreviation costs nothing and hides the
  five parameters just as well.\<close>
abbreviation ieval :: "'a ipoly \<Rightarrow> (nat \<Rightarrow> 'a ipoly) \<Rightarrow> 'a ipoly"
  where "ieval \<equiv> Ring.eval ipoly_carrier (\<oplus>\<^sub>I) (\<otimes>\<^sub>I) \<zero>\<^sub>I \<one>\<^sub>I"

text \<open>An extension is closed under the roots it mentions: whenever one of its elements involves the
  indeterminate @{term "(P, i)"}, that indeterminate belongs to the extension, and is a root of
  @{term P} there.  This is the condition that forces a \<^emph>\<open>maximal\<close> extension to split every
  polynomial --- an unsplit polynomial leaves some index unused, and adjoining a root at it yields a
  strictly larger extension.\<close>
definition root_closed :: "'a iext \<Rightarrow> bool"
  where "root_closed E \<longleftrightarrow>
    (\<forall>\<P> \<in> ecarrier E. \<forall>P \<in> poly_carrier. \<forall>i.
       \<not> index_free \<P> (P, i) \<longrightarrow>
         ivar (P, i) \<in> ecarrier E \<and> eeval E (ivar (P, i)) (lift_poly P) = \<zero>\<^sub>I)"

lemma root_closedI:
  "(\<And>\<P> P i. \<lbrakk> \<P> \<in> ecarrier E; P \<in> poly_carrier; \<not> index_free \<P> (P, i) \<rbrakk>
             \<Longrightarrow> ivar (P, i) \<in> ecarrier E \<and> eeval E (ivar (P, i)) (lift_poly P) = \<zero>\<^sub>I)
   \<Longrightarrow> root_closed E"
  unfolding root_closed_def by blast

lemma root_closed_mem:
  "\<lbrakk> root_closed E; \<P> \<in> ecarrier E; P \<in> poly_carrier; \<not> index_free \<P> (P, i) \<rbrakk>
     \<Longrightarrow> ivar (P, i) \<in> ecarrier E"
  unfolding root_closed_def by blast

lemma root_closed_eval:
  "\<lbrakk> root_closed E; \<P> \<in> ecarrier E; P \<in> poly_carrier; \<not> index_free \<P> (P, i) \<rbrakk>
     \<Longrightarrow> eeval E (ivar (P, i)) (lift_poly P) = \<zero>\<^sub>I"
  unfolding root_closed_def by blast

text \<open>An extension of @{term R} inside the indexed polynomial ring: a field of indexed polynomials
  over @{term R} that contains the constants, induces on them the ring operations of @{term R}, and
  is closed under the roots it mentions.\<close>
definition is_extension :: "'a iext \<Rightarrow> bool"
  where "is_extension E \<longleftrightarrow>
     Field (ecarrier E) (eadd E) (emult E) \<zero>\<^sub>I \<one>\<^sub>I
   \<and> ecarrier E \<subseteq> ipoly_carrier
   \<and> (\<forall>a \<in> R. ipoly_const a \<in> ecarrier E)
   \<and> (\<forall>a \<in> R. \<forall>b \<in> R. eadd E (ipoly_const a) (ipoly_const b) = ipoly_const (a + b))
   \<and> (\<forall>a \<in> R. \<forall>b \<in> R. emult E (ipoly_const a) (ipoly_const b) = ipoly_const (a \<cdot> b))
   \<and> root_closed E
   \<and> op_restricted (ecarrier E) (eadd E)
   \<and> op_restricted (ecarrier E) (emult E)"

definition extensions :: "'a iext set"
  where "extensions = {E. is_extension E}"

lemma extensions_iff [simp]: "E \<in> extensions \<longleftrightarrow> is_extension E"
  by (simp add: extensions_def)

text \<open>The component facts, so that clients never unfold @{const is_extension}.\<close>

lemma is_extension_field: "is_extension E \<Longrightarrow> Field (ecarrier E) (eadd E) (emult E) \<zero>\<^sub>I \<one>\<^sub>I"
  by (simp add: is_extension_def)

lemma is_extension_subset: "is_extension E \<Longrightarrow> ecarrier E \<subseteq> ipoly_carrier"
  by (simp add: is_extension_def)

lemma is_extension_carrier_closed: "\<lbrakk> is_extension E; x \<in> ecarrier E \<rbrakk> \<Longrightarrow> x \<in> ipoly_carrier"
  using is_extension_subset by blast

lemma is_extension_const_mem: "\<lbrakk> is_extension E; a \<in> R \<rbrakk> \<Longrightarrow> ipoly_const a \<in> ecarrier E"
  by (simp add: is_extension_def)

lemma is_extension_const_add:
  "\<lbrakk> is_extension E; a \<in> R; b \<in> R \<rbrakk>
     \<Longrightarrow> eadd E (ipoly_const a) (ipoly_const b) = ipoly_const (a + b)"
  by (simp add: is_extension_def)

lemma is_extension_const_mult:
  "\<lbrakk> is_extension E; a \<in> R; b \<in> R \<rbrakk>
     \<Longrightarrow> emult E (ipoly_const a) (ipoly_const b) = ipoly_const (a \<cdot> b)"
  by (simp add: is_extension_def)

lemma is_extension_root_closed: "is_extension E \<Longrightarrow> root_closed E"
  by (simp add: is_extension_def)

lemma is_extension_restricted:
  "is_extension E \<Longrightarrow> op_restricted (ecarrier E) (eadd E)"
  "is_extension E \<Longrightarrow> op_restricted (ecarrier E) (emult E)"
  by (simp_all add: is_extension_def)

lemma is_extensionI:
  assumes "Field (ecarrier E) (eadd E) (emult E) \<zero>\<^sub>I \<one>\<^sub>I"
    and "ecarrier E \<subseteq> ipoly_carrier"
    and "\<And>a. a \<in> R \<Longrightarrow> ipoly_const a \<in> ecarrier E"
    and "\<And>a b. \<lbrakk> a \<in> R; b \<in> R \<rbrakk>
                \<Longrightarrow> eadd E (ipoly_const a) (ipoly_const b) = ipoly_const (a + b)"
    and "\<And>a b. \<lbrakk> a \<in> R; b \<in> R \<rbrakk>
                \<Longrightarrow> emult E (ipoly_const a) (ipoly_const b) = ipoly_const (a \<cdot> b)"
    and "root_closed E"
    and "op_restricted (ecarrier E) (eadd E)"
    and "op_restricted (ecarrier E) (emult E)"
  shows "is_extension E"
  unfolding is_extension_def using assms by blast


subsection \<open>The ordering by inclusion\<close>

text \<open>One extension extends another when its carrier is contained in the other's and its operations
  agree with the other's wherever the smaller one is defined.\<close>
definition ext_le :: "'a iext \<Rightarrow> 'a iext \<Rightarrow> bool"
  where "ext_le E F \<longleftrightarrow> ecarrier E \<subseteq> ecarrier F
       \<and> (\<forall>x \<in> ecarrier E. \<forall>y \<in> ecarrier E.
            eadd E x y = eadd F x y \<and> emult E x y = emult F x y)"

lemma ext_leI:
  "\<lbrakk> ecarrier E \<subseteq> ecarrier F;
     \<And>x y. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E \<rbrakk> \<Longrightarrow> eadd E x y = eadd F x y;
     \<And>x y. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E \<rbrakk> \<Longrightarrow> emult E x y = emult F x y \<rbrakk>
   \<Longrightarrow> ext_le E F"
  unfolding ext_le_def by blast

lemma ext_le_carrier: "ext_le E F \<Longrightarrow> ecarrier E \<subseteq> ecarrier F"
  by (simp add: ext_le_def)

lemma ext_le_add: "\<lbrakk> ext_le E F; x \<in> ecarrier E; y \<in> ecarrier E \<rbrakk> \<Longrightarrow> eadd E x y = eadd F x y"
  unfolding ext_le_def by blast

lemma ext_le_mult: "\<lbrakk> ext_le E F; x \<in> ecarrier E; y \<in> ecarrier E \<rbrakk> \<Longrightarrow> emult E x y = emult F x y"
  unfolding ext_le_def by blast

lemma ext_le_refl: "ext_le E E"
  by (simp add: ext_le_def)

lemma ext_le_trans:
  assumes EF: "ext_le E F" and FG: "ext_le F G" shows "ext_le E G"
proof (rule ext_leI)
  show sub: "ecarrier E \<subseteq> ecarrier G"
    by (rule subset_trans [OF ext_le_carrier [OF EF] ext_le_carrier [OF FG]])
  fix x y assume xy: "x \<in> ecarrier E" "y \<in> ecarrier E"
  then have xyF: "x \<in> ecarrier F" "y \<in> ecarrier F"
    using ext_le_carrier [OF EF] by auto
  show "eadd E x y = eadd G x y"
    using ext_le_add [OF EF xy(1) xy(2)] ext_le_add [OF FG xyF(1) xyF(2)] by simp
  show "emult E x y = emult G x y"
    using ext_le_mult [OF EF xy(1) xy(2)] ext_le_mult [OF FG xyF(1) xyF(2)] by simp
qed

text \<open>Antisymmetry is where restrictedness earns its place: equal carriers and agreement on them
  settle the operations there, and off the carrier both are @{const undefined}.\<close>
lemma ext_le_antisym:
  assumes E: "is_extension E" and F: "is_extension F"
    and EF: "ext_le E F" and FE: "ext_le F E"
  shows "E = F"
proof -
  have K: "ecarrier E = ecarrier F"
    by (rule subset_antisym [OF ext_le_carrier [OF EF] ext_le_carrier [OF FE]])
  have rF: "op_restricted (ecarrier E) (eadd F)" "op_restricted (ecarrier E) (emult F)"
    using is_extension_restricted [OF F] K by simp_all
  have "eadd E = eadd F"
    by (rule restricted_op_eqI [OF is_extension_restricted(1) [OF E] rF(1) ext_le_add [OF EF]])
  moreover have "emult E = emult F"
    by (rule restricted_op_eqI [OF is_extension_restricted(2) [OF E] rF(2) ext_le_mult [OF EF]])
  ultimately have "(ecarrier E, eadd E, emult E) = (ecarrier F, eadd F, emult F)"
    using K by simp
  then show ?thesis by simp
qed

theorem ext_partial_order: "partial_order_on extensions (relation_of ext_le extensions)"
proof (rule partial_order_on_relation_ofI)
  show "\<And>E. E \<in> extensions \<Longrightarrow> ext_le E E" by (rule ext_le_refl)
  show "\<And>E F G. \<lbrakk> E \<in> extensions; F \<in> extensions; G \<in> extensions; ext_le E F; ext_le F G \<rbrakk>
                 \<Longrightarrow> ext_le E G"
    by (rule ext_le_trans)
  show "\<And>E F. \<lbrakk> E \<in> extensions; F \<in> extensions; ext_le E F; ext_le F E \<rbrakk> \<Longrightarrow> E = F"
    by (metis extensions_iff ext_le_antisym)
qed


subsection \<open>Powers and evaluation transfer along the ordering\<close>

text \<open>A power or an evaluation of an element of the smaller extension is the same whether computed
  there or in the larger one.  Nothing beyond ring-ness of the two, carrier inclusion, and agreement
  of the operations on the smaller carrier is used --- that is, exactly @{const ext_le} --- so the
  same two lemmas serve the union of a chain and the adjunction of a root.

  There is no such fact one level down: @{term "commutative_monoid.fincomp"} depends on the
  \<^emph>\<open>carrier\<close> as well as the operation, through its @{text M_ify}, so
  @{thm [source] commutative_monoid.fincomp_cong'}, which stays inside one monoid, does not apply.
  @{thm [source] fincomp_transfer} is what bridges the two carriers.\<close>

lemma ext_le_rpow:
  assumes RE: "Ring (ecarrier E) (eadd E) (emult E) \<zero>\<^sub>I \<one>\<^sub>I"
    and RF: "Ring (ecarrier F) (eadd F) (emult F) \<zero>\<^sub>I \<one>\<^sub>I"
    and le: "ext_le E F" and a: "a \<in> ecarrier E"
  shows "Ring.rpow (emult F) \<one>\<^sub>I a n = Ring.rpow (emult E) \<one>\<^sub>I a n"
proof (induct n)
  case 0
  show ?case by (simp add: Ring.rpow_0 [OF RE] Ring.rpow_0 [OF RF])
next
  case (Suc n)
  have cl: "Ring.rpow (emult E) \<one>\<^sub>I a n \<in> ecarrier E" by (rule Ring.rpow_closed [OF RE a])
  have "Ring.rpow (emult F) \<one>\<^sub>I a (Suc n) = emult F a (Ring.rpow (emult F) \<one>\<^sub>I a n)"
    by (rule Ring.rpow_Suc [OF RF])
  also have "\<dots> = emult F a (Ring.rpow (emult E) \<one>\<^sub>I a n)" using Suc by simp
  also have "\<dots> = emult E a (Ring.rpow (emult E) \<one>\<^sub>I a n)"
    by (rule ext_le_mult [OF le a cl, symmetric])
  also have "\<dots> = Ring.rpow (emult E) \<one>\<^sub>I a (Suc n)" by (rule Ring.rpow_Suc [OF RE, symmetric])
  finally show ?case .
qed

lemma ext_le_eval:
  assumes RE: "Ring (ecarrier E) (eadd E) (emult E) \<zero>\<^sub>I \<one>\<^sub>I"
    and RF: "Ring (ecarrier F) (eadd F) (emult F) \<zero>\<^sub>I \<one>\<^sub>I"
    and le: "ext_le E F" and a: "a \<in> ecarrier E" and p: "\<And>k. p k \<in> ecarrier E"
  shows "eeval F a p = eeval E a p"
proof -
  interpret E: Ring "ecarrier E" "eadd E" "emult E" "\<zero>\<^sub>I" "\<one>\<^sub>I" by (rule RE)
  have cl: "Ring.rpow (emult E) \<one>\<^sub>I a i \<in> ecarrier E" for i by (rule Ring.rpow_closed [OF RE a])
  have summand: "emult F (p i) (Ring.rpow (emult F) \<one>\<^sub>I a i)
                 = emult E (p i) (Ring.rpow (emult E) \<one>\<^sub>I a i)" for i
    using ext_le_rpow [OF RE RF le a] ext_le_mult [OF le p cl] by simp
  have inE: "(\<lambda>i. emult E (p i) (Ring.rpow (emult E) \<one>\<^sub>I a i)) \<in> A \<rightarrow> ecarrier E" for A
    using p cl by auto
  have "eeval F a p
        = commutative_monoid.fincomp (ecarrier F) (eadd F) \<zero>\<^sub>I
            (\<lambda>i. emult F (p i) (Ring.rpow (emult F) \<one>\<^sub>I a i)) {..Ring.degree \<zero>\<^sub>I p}"
    by (rule Ring.eval_def [OF RF])
  also have "\<dots> = commutative_monoid.fincomp (ecarrier F) (eadd F) \<zero>\<^sub>I
            (\<lambda>i. emult E (p i) (Ring.rpow (emult E) \<one>\<^sub>I a i)) {..Ring.degree \<zero>\<^sub>I p}"
    using summand by simp
  also have "\<dots> = commutative_monoid.fincomp (ecarrier E) (eadd E) \<zero>\<^sub>I
            (\<lambda>i. emult E (p i) (Ring.rpow (emult E) \<one>\<^sub>I a i)) {..Ring.degree \<zero>\<^sub>I p}"
  proof (rule fincomp_transfer [symmetric])
    show "commutative_monoid (ecarrier E) (eadd E) \<zero>\<^sub>I"
      using RE by (simp add: Ring_def Abelian_Group_def)
    show "commutative_monoid (ecarrier F) (eadd F) \<zero>\<^sub>I"
      using RF by (simp add: Ring_def Abelian_Group_def)
    show "ecarrier E \<subseteq> ecarrier F" by (rule ext_le_carrier [OF le])
    show "\<And>x y. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E \<rbrakk> \<Longrightarrow> eadd E x y = eadd F x y"
      by (rule ext_le_add [OF le])
    show "(\<lambda>i. emult E (p i) (Ring.rpow (emult E) \<one>\<^sub>I a i)) \<in> {..Ring.degree \<zero>\<^sub>I p} \<rightarrow> ecarrier E"
      by (rule inE)
  qed
  also have "\<dots> = eeval E a p" by (rule Ring.eval_def [OF RE, symmetric])
  finally show ?thesis .
qed


subsection \<open>The base extension\<close>

text \<open>The constants form an extension: a copy of @{term R} inside the indexed polynomial ring,
  carrying the ambient operations restricted to it.  Besides supplying the upper bound Zorn needs for
  the \<^emph>\<open>empty\<close> chain, this is the check that @{const is_extension} is satisfiable at all --- a
  condition as encoded as @{const root_closed} could easily be vacuous, and then everything proved
  from it would be too.  Here @{const root_closed} holds vacuously \<^emph>\<open>by design\<close>: a constant involves
  no indeterminate, so its hypothesis is never met.\<close>
definition base_ext :: "'a iext"
  where "base_ext =
    (ipoly_const ` R,
     (\<lambda>x y. if x \<in> ipoly_const ` R \<and> y \<in> ipoly_const ` R then x \<oplus>\<^sub>I y else undefined),
     (\<lambda>x y. if x \<in> ipoly_const ` R \<and> y \<in> ipoly_const ` R then x \<otimes>\<^sub>I y else undefined))"

lemma base_ext_carrier [simp]: "ecarrier base_ext = ipoly_const ` R"
  by (simp add: base_ext_def)

lemma base_ext_add:
  assumes "a \<in> R" and "b \<in> R"
  shows "eadd base_ext (ipoly_const a) (ipoly_const b) = ipoly_const (a + b)"
  using assms by (simp add: base_ext_def ipoly_const_add)

lemma base_ext_mult:
  assumes "a \<in> R" and "b \<in> R"
  shows "emult base_ext (ipoly_const a) (ipoly_const b) = ipoly_const (a \<cdot> b)"
  using assms by (simp add: base_ext_def ipoly_const_mult)

lemma base_ext_restricted:
  "op_restricted (ecarrier base_ext) (eadd base_ext)"
  "op_restricted (ecarrier base_ext) (emult base_ext)"
  by (auto simp: base_ext_def intro!: op_restrictedI)


subsection \<open>Unions of chains\<close>

text \<open>A chain of extensions: a subset of @{const extensions} any two of whose members are comparable.
  Its union is again an extension, and is an upper bound --- which is what Zorn's lemma asks for.\<close>
definition ext_chain :: "'a iext set \<Rightarrow> bool"
  where "ext_chain C \<longleftrightarrow> C \<subseteq> extensions \<and> (\<forall>E \<in> C. \<forall>F \<in> C. ext_le E F \<or> ext_le F E)"

lemma ext_chainD_extension: "\<lbrakk> ext_chain C; E \<in> C \<rbrakk> \<Longrightarrow> is_extension E"
  unfolding ext_chain_def by auto

lemma ext_chainD_comparable: "\<lbrakk> ext_chain C; E \<in> C; F \<in> C \<rbrakk> \<Longrightarrow> ext_le E F \<or> ext_le F E"
  unfolding ext_chain_def by blast

text \<open>The union carries, on each pair of elements, the operations of any member containing both;
  the chain condition makes the choice immaterial.\<close>
definition ext_Union :: "'a iext set \<Rightarrow> 'a iext"
  where "ext_Union C =
    (\<Union> (ecarrier ` C),
     (\<lambda>x y. if x \<in> \<Union> (ecarrier ` C) \<and> y \<in> \<Union> (ecarrier ` C)
            then eadd (SOME E. E \<in> C \<and> x \<in> ecarrier E \<and> y \<in> ecarrier E) x y else undefined),
     (\<lambda>x y. if x \<in> \<Union> (ecarrier ` C) \<and> y \<in> \<Union> (ecarrier ` C)
            then emult (SOME E. E \<in> C \<and> x \<in> ecarrier E \<and> y \<in> ecarrier E) x y else undefined))"

lemma ext_Union_carrier [simp]: "ecarrier (ext_Union C) = \<Union> (ecarrier ` C)"
  by (simp add: ext_Union_def)

lemma ext_Union_restricted:
  "op_restricted (ecarrier (ext_Union C)) (eadd (ext_Union C))"
  "op_restricted (ecarrier (ext_Union C)) (emult (ext_Union C))"
  by (auto simp: ext_Union_def intro!: op_restrictedI)


context
  fixes C :: "'a iext set"
  assumes chain: "ext_chain C"
begin

lemma chain_field: "E \<in> C \<Longrightarrow> Field (ecarrier E) (eadd E) (emult E) \<zero>\<^sub>I \<one>\<^sub>I"
  using chain by (simp add: ext_chainD_extension is_extension_field)

text \<open>Two elements of the union lie in a common member: the larger of two members containing them.\<close>
lemma chain_common2:
  assumes "x \<in> ecarrier (ext_Union C)" and "y \<in> ecarrier (ext_Union C)"
  shows "\<exists>E \<in> C. x \<in> ecarrier E \<and> y \<in> ecarrier E"
proof -
  from assms obtain E F where E: "E \<in> C" "x \<in> ecarrier E" and F: "F \<in> C" "y \<in> ecarrier F"
    by auto
  from ext_chainD_comparable [OF chain E(1) F(1)] show ?thesis
  proof
    assume "ext_le E F"
    then have "x \<in> ecarrier F" using E(2) ext_le_carrier by blast
    then show ?thesis using F by blast
  next
    assume "ext_le F E"
    then have "y \<in> ecarrier E" using F(2) ext_le_carrier by blast
    then show ?thesis using E by blast
  qed
qed

lemma chain_common3:
  assumes "x \<in> ecarrier (ext_Union C)" and "y \<in> ecarrier (ext_Union C)"
    and "z \<in> ecarrier (ext_Union C)"
  shows "\<exists>E \<in> C. x \<in> ecarrier E \<and> y \<in> ecarrier E \<and> z \<in> ecarrier E"
proof -
  from chain_common2 [OF assms(1,2)] obtain E
    where E: "E \<in> C" "x \<in> ecarrier E" "y \<in> ecarrier E" by blast
  from assms(3) obtain F where F: "F \<in> C" "z \<in> ecarrier F" by auto
  from ext_chainD_comparable [OF chain E(1) F(1)] show ?thesis
  proof
    assume "ext_le E F"
    then have "x \<in> ecarrier F" "y \<in> ecarrier F" using E ext_le_carrier by blast+
    then show ?thesis using F by blast
  next
    assume "ext_le F E"
    then have "z \<in> ecarrier E" using F(2) ext_le_carrier by blast
    then show ?thesis using E by blast
  qed
qed

text \<open>The union's operations agree with those of any member containing both arguments.\<close>
lemma ext_Union_ops:
  assumes E: "E \<in> C" and x: "x \<in> ecarrier E" and y: "y \<in> ecarrier E"
  shows "eadd (ext_Union C) x y = eadd E x y"
    and "emult (ext_Union C) x y = emult E x y"
proof -
  have mem: "x \<in> \<Union> (ecarrier ` C)" "y \<in> \<Union> (ecarrier ` C)" using E x y by auto
  have ex: "\<exists>F. F \<in> C \<and> x \<in> ecarrier F \<and> y \<in> ecarrier F" using E x y by blast
  let ?F = "SOME F. F \<in> C \<and> x \<in> ecarrier F \<and> y \<in> ecarrier F"
  have F: "?F \<in> C" and xF: "x \<in> ecarrier ?F" and yF: "y \<in> ecarrier ?F"
    using someI_ex [OF ex] by auto
  have or: "ext_le E ?F \<or> ext_le ?F E" by (rule ext_chainD_comparable [OF chain E F])
  have a: "eadd E x y = eadd ?F x y"
  proof (cases "ext_le E ?F")
    case True then show ?thesis using x y by (simp add: ext_le_add)
  next
    case False
    then have "ext_le ?F E" using or by blast
    then show ?thesis using xF yF by (simp add: ext_le_add)
  qed
  have m: "emult E x y = emult ?F x y"
  proof (cases "ext_le E ?F")
    case True then show ?thesis using x y by (simp add: ext_le_mult)
  next
    case False
    then have "ext_le ?F E" using or by blast
    then show ?thesis using xF yF by (simp add: ext_le_mult)
  qed
  show "eadd (ext_Union C) x y = eadd E x y"
    using mem a by (simp add: ext_Union_def)
  show "emult (ext_Union C) x y = emult E x y"
    using mem m by (simp add: ext_Union_def)
qed

lemma ext_Union_upper_bound: "E \<in> C \<Longrightarrow> ext_le E (ext_Union C)"
  by (rule ext_leI) (auto simp: ext_Union_ops)

text \<open>Every member's carrier contains \<open>\<zero>\<^sub>I\<close> and \<open>\<one>\<^sub>I\<close>, being an extension of @{term R}.\<close>
lemma chain_zero_one_mem:
  assumes E: "E \<in> C" shows "\<zero>\<^sub>I \<in> ecarrier E" and "\<one>\<^sub>I \<in> ecarrier E"
proof -
  have ext: "is_extension E" using chain E by (rule ext_chainD_extension)
  have "ipoly_const \<zero> \<in> ecarrier E"
    by (rule is_extension_const_mem [OF ext additive.unit_closed])
  moreover have "ipoly_const \<one> \<in> ecarrier E"
    by (rule is_extension_const_mem [OF ext multiplicative.unit_closed])
  ultimately show "\<zero>\<^sub>I \<in> ecarrier E" and "\<one>\<^sub>I \<in> ecarrier E" by simp_all
qed

text \<open>The field laws of a single member, extracted through one interpretation so that the union's
  proof below can cite them without re-interpreting for every axiom.\<close>
lemma chain_member:
  assumes E: "E \<in> C"
  shows chain_add_closed: "\<And>x y. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E \<rbrakk>
                                  \<Longrightarrow> eadd E x y \<in> ecarrier E"
    and chain_mult_closed: "\<And>x y. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E \<rbrakk>
                                   \<Longrightarrow> emult E x y \<in> ecarrier E"
    and chain_add_assoc: "\<And>x y z. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E; z \<in> ecarrier E \<rbrakk>
                                   \<Longrightarrow> eadd E (eadd E x y) z = eadd E x (eadd E y z)"
    and chain_mult_assoc: "\<And>x y z. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E; z \<in> ecarrier E \<rbrakk>
                                    \<Longrightarrow> emult E (emult E x y) z = emult E x (emult E y z)"
    and chain_add_zero: "\<And>x. x \<in> ecarrier E \<Longrightarrow> eadd E \<zero>\<^sub>I x = x"
    and chain_add_zero': "\<And>x. x \<in> ecarrier E \<Longrightarrow> eadd E x \<zero>\<^sub>I = x"
    and chain_mult_one: "\<And>x. x \<in> ecarrier E \<Longrightarrow> emult E \<one>\<^sub>I x = x"
    and chain_mult_one': "\<And>x. x \<in> ecarrier E \<Longrightarrow> emult E x \<one>\<^sub>I = x"
    and chain_add_comm: "\<And>x y. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E \<rbrakk>
                                \<Longrightarrow> eadd E x y = eadd E y x"
    and chain_mult_comm: "\<And>x y. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E \<rbrakk>
                                 \<Longrightarrow> emult E x y = emult E y x"
    and chain_distrib: "\<And>x y z. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E; z \<in> ecarrier E \<rbrakk>
                                 \<Longrightarrow> emult E x (eadd E y z) = eadd E (emult E x y) (emult E x z)"
    and chain_distrib': "\<And>x y z. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E; z \<in> ecarrier E \<rbrakk>
                                  \<Longrightarrow> emult E (eadd E y z) x = eadd E (emult E y x) (emult E z x)"
    and chain_add_inv: "\<And>x. x \<in> ecarrier E
                             \<Longrightarrow> \<exists>y \<in> ecarrier E. eadd E x y = \<zero>\<^sub>I \<and> eadd E y x = \<zero>\<^sub>I"
    and chain_mult_inv: "\<And>x. \<lbrakk> x \<in> ecarrier E; x \<noteq> \<zero>\<^sub>I \<rbrakk>
                              \<Longrightarrow> \<exists>y \<in> ecarrier E. emult E x y = \<one>\<^sub>I \<and> emult E y x = \<one>\<^sub>I"
proof -
  interpret E: Field "ecarrier E" "eadd E" "emult E" "\<zero>\<^sub>I" "\<one>\<^sub>I"
    by (rule chain_field [OF E])
  show "\<And>x y. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E \<rbrakk> \<Longrightarrow> eadd E x y \<in> ecarrier E" by simp
  show "\<And>x y. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E \<rbrakk> \<Longrightarrow> emult E x y \<in> ecarrier E" by simp
  show "\<And>x y z. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E; z \<in> ecarrier E \<rbrakk>
                 \<Longrightarrow> eadd E (eadd E x y) z = eadd E x (eadd E y z)"
    by (simp add: E.additive.associative)
  show "\<And>x y z. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E; z \<in> ecarrier E \<rbrakk>
                 \<Longrightarrow> emult E (emult E x y) z = emult E x (emult E y z)"
    by (simp add: E.multiplicative.associative)
  show "\<And>x. x \<in> ecarrier E \<Longrightarrow> eadd E \<zero>\<^sub>I x = x" by simp
  show "\<And>x. x \<in> ecarrier E \<Longrightarrow> eadd E x \<zero>\<^sub>I = x" by simp
  show "\<And>x. x \<in> ecarrier E \<Longrightarrow> emult E \<one>\<^sub>I x = x" by simp
  show "\<And>x. x \<in> ecarrier E \<Longrightarrow> emult E x \<one>\<^sub>I = x" by simp
  show "\<And>x y. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E \<rbrakk> \<Longrightarrow> eadd E x y = eadd E y x"
    by (simp add: E.additive.commutative)
  show "\<And>x y. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E \<rbrakk> \<Longrightarrow> emult E x y = emult E y x"
    by (simp add: E.multiplicative.commutative)
  show "\<And>x y z. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E; z \<in> ecarrier E \<rbrakk>
                 \<Longrightarrow> emult E x (eadd E y z) = eadd E (emult E x y) (emult E x z)"
    by (simp add: E.distributive(1))
  show "\<And>x y z. \<lbrakk> x \<in> ecarrier E; y \<in> ecarrier E; z \<in> ecarrier E \<rbrakk>
                 \<Longrightarrow> emult E (eadd E y z) x = eadd E (emult E y x) (emult E z x)"
    by (simp add: E.distributive(2))
  show "\<And>x. x \<in> ecarrier E \<Longrightarrow> \<exists>y \<in> ecarrier E. eadd E x y = \<zero>\<^sub>I \<and> eadd E y x = \<zero>\<^sub>I"
  proof -
    fix x assume x: "x \<in> ecarrier E"
    have "E.additive.inverse x \<in> ecarrier E" using x by simp
    moreover have "eadd E x (E.additive.inverse x) = \<zero>\<^sub>I"
      using x by (simp add: E.additive.invertible_right_inverse)
    moreover have "eadd E (E.additive.inverse x) x = \<zero>\<^sub>I"
      using x by (simp add: E.additive.invertible_left_inverse)
    ultimately show "\<exists>y \<in> ecarrier E. eadd E x y = \<zero>\<^sub>I \<and> eadd E y x = \<zero>\<^sub>I" by blast
  qed
  show "\<And>x. \<lbrakk> x \<in> ecarrier E; x \<noteq> \<zero>\<^sub>I \<rbrakk>
             \<Longrightarrow> \<exists>y \<in> ecarrier E. emult E x y = \<one>\<^sub>I \<and> emult E y x = \<one>\<^sub>I"
  proof -
    fix x assume x: "x \<in> ecarrier E" and xnz: "x \<noteq> \<zero>\<^sub>I"
    have inv: "E.multiplicative.invertible x" by (rule E.field_inverse [OF x xnz])
    have "E.multiplicative.inverse x \<in> ecarrier E"
      by (rule E.multiplicative.invertible_inverse_closed [OF inv x])
    moreover have "emult E x (E.multiplicative.inverse x) = \<one>\<^sub>I"
      by (rule E.multiplicative.invertible_right_inverse [OF inv x])
    moreover have "emult E (E.multiplicative.inverse x) x = \<one>\<^sub>I"
      by (rule E.multiplicative.invertible_left_inverse [OF inv x])
    ultimately show "\<exists>y \<in> ecarrier E. emult E x y = \<one>\<^sub>I \<and> emult E y x = \<one>\<^sub>I" by blast
  qed
qed

text \<open>The union of a nonempty chain is a field.  Each axiom involves at most three elements, which
  a common member accommodates; there the axiom holds, and the union's operations agree with that
  member's.\<close>
lemma ext_Union_field:
  assumes ne: "C \<noteq> {}" and nz: "\<one> \<noteq> \<zero>"
  shows "Field (ecarrier (ext_Union C)) (eadd (ext_Union C)) (emult (ext_Union C)) \<zero>\<^sub>I \<one>\<^sub>I"
proof -
  obtain E0 where E0: "E0 \<in> C" using ne by blast
  have zmem: "\<zero>\<^sub>I \<in> ecarrier (ext_Union C)"
    using E0 chain_zero_one_mem(1) [OF E0] unfolding ext_Union_carrier by blast
  have omem: "\<one>\<^sub>I \<in> ecarrier (ext_Union C)"
    using E0 chain_zero_one_mem(2) [OF E0] unfolding ext_Union_carrier by blast
  have grp: "Group (ecarrier (ext_Union C)) (eadd (ext_Union C)) \<zero>\<^sub>I"
  proof (rule GroupI)
    fix x y assume "x \<in> ecarrier (ext_Union C)" and "y \<in> ecarrier (ext_Union C)"
    then obtain E where E: "E \<in> C" "x \<in> ecarrier E" "y \<in> ecarrier E"
      using chain_common2 by blast
    then show "eadd (ext_Union C) x y \<in> ecarrier (ext_Union C)"
      using ext_Union_ops(1) [OF E] chain_add_closed [OF E(1)] by auto
  next
    show "\<zero>\<^sub>I \<in> ecarrier (ext_Union C)" by (rule zmem)
  next
    fix x y z
    assume "x \<in> ecarrier (ext_Union C)" "y \<in> ecarrier (ext_Union C)" "z \<in> ecarrier (ext_Union C)"
    then obtain E where E: "E \<in> C" "x \<in> ecarrier E" "y \<in> ecarrier E" "z \<in> ecarrier E"
      using chain_common3 by blast
    have "eadd E x y \<in> ecarrier E" and "eadd E y z \<in> ecarrier E"
      using chain_add_closed [OF E(1)] E by auto
    then show "eadd (ext_Union C) (eadd (ext_Union C) x y) z
               = eadd (ext_Union C) x (eadd (ext_Union C) y z)"
      using ext_Union_ops(1) [OF E(1)] E chain_add_assoc [OF E(1)] by simp
  next
    fix x assume "x \<in> ecarrier (ext_Union C)"
    then obtain E where E: "E \<in> C" "x \<in> ecarrier E" by auto
    then show "eadd (ext_Union C) \<zero>\<^sub>I x = x"
      using ext_Union_ops(1) [OF E(1) chain_zero_one_mem(1) [OF E(1)] E(2)]
            chain_add_zero [OF E(1) E(2)] by simp
  next
    fix x assume "x \<in> ecarrier (ext_Union C)"
    then obtain E where E: "E \<in> C" "x \<in> ecarrier E" by auto
    then show "eadd (ext_Union C) x \<zero>\<^sub>I = x"
      using ext_Union_ops(1) [OF E(1) E(2) chain_zero_one_mem(1) [OF E(1)]]
            chain_add_zero' [OF E(1) E(2)] by simp
  next
    fix x assume "x \<in> ecarrier (ext_Union C)"
    then obtain E where E: "E \<in> C" "x \<in> ecarrier E" by auto
    from chain_add_inv [OF E(1) E(2)] obtain y
      where y: "y \<in> ecarrier E" "eadd E x y = \<zero>\<^sub>I" "eadd E y x = \<zero>\<^sub>I" by blast
    then show "\<exists>v \<in> ecarrier (ext_Union C).
                 eadd (ext_Union C) x v = \<zero>\<^sub>I \<and> eadd (ext_Union C) v x = \<zero>\<^sub>I"
      using ext_Union_ops(1) [OF E(1) E(2) y(1)] ext_Union_ops(1) [OF E(1) y(1) E(2)] E by auto
  qed
  interpret Uadd: Group "ecarrier (ext_Union C)" "eadd (ext_Union C)" "\<zero>\<^sub>I" by (rule grp)
  interpret Uadd: Abelian_Group "ecarrier (ext_Union C)" "eadd (ext_Union C)" "\<zero>\<^sub>I"
  proof unfold_locales
    fix x y assume "x \<in> ecarrier (ext_Union C)" and "y \<in> ecarrier (ext_Union C)"
    then obtain E where E: "E \<in> C" "x \<in> ecarrier E" "y \<in> ecarrier E"
      using chain_common2 by blast
    then show "eadd (ext_Union C) x y = eadd (ext_Union C) y x"
      using ext_Union_ops(1) [OF E(1) E(2) E(3)] ext_Union_ops(1) [OF E(1) E(3) E(2)]
            chain_add_comm [OF E(1) E(2) E(3)] by simp
  qed
  interpret Umult: commutative_monoid "ecarrier (ext_Union C)" "emult (ext_Union C)" "\<one>\<^sub>I"
  proof unfold_locales
    fix x y assume "x \<in> ecarrier (ext_Union C)" and "y \<in> ecarrier (ext_Union C)"
    then obtain E where E: "E \<in> C" "x \<in> ecarrier E" "y \<in> ecarrier E"
      using chain_common2 by blast
    then show "emult (ext_Union C) x y \<in> ecarrier (ext_Union C)"
      using ext_Union_ops(2) [OF E] chain_mult_closed [OF E(1)] by auto
  next
    show "\<one>\<^sub>I \<in> ecarrier (ext_Union C)" by (rule omem)
  next
    fix x y z
    assume "x \<in> ecarrier (ext_Union C)" "y \<in> ecarrier (ext_Union C)" "z \<in> ecarrier (ext_Union C)"
    then obtain E where E: "E \<in> C" "x \<in> ecarrier E" "y \<in> ecarrier E" "z \<in> ecarrier E"
      using chain_common3 by blast
    have "emult E x y \<in> ecarrier E" and "emult E y z \<in> ecarrier E"
      using chain_mult_closed [OF E(1)] E by auto
    then show "emult (ext_Union C) (emult (ext_Union C) x y) z
               = emult (ext_Union C) x (emult (ext_Union C) y z)"
      using ext_Union_ops(2) [OF E(1)] E chain_mult_assoc [OF E(1)] by simp
  next
    fix x assume "x \<in> ecarrier (ext_Union C)"
    then obtain E where E: "E \<in> C" "x \<in> ecarrier E" by auto
    then show "emult (ext_Union C) \<one>\<^sub>I x = x"
      using ext_Union_ops(2) [OF E(1) chain_zero_one_mem(2) [OF E(1)] E(2)]
            chain_mult_one [OF E(1) E(2)] by simp
  next
    fix x assume "x \<in> ecarrier (ext_Union C)"
    then obtain E where E: "E \<in> C" "x \<in> ecarrier E" by auto
    then show "emult (ext_Union C) x \<one>\<^sub>I = x"
      using ext_Union_ops(2) [OF E(1) E(2) chain_zero_one_mem(2) [OF E(1)]]
            chain_mult_one' [OF E(1) E(2)] by simp
  next
    fix x y assume "x \<in> ecarrier (ext_Union C)" and "y \<in> ecarrier (ext_Union C)"
    then obtain E where E: "E \<in> C" "x \<in> ecarrier E" "y \<in> ecarrier E"
      using chain_common2 by blast
    then show "emult (ext_Union C) x y = emult (ext_Union C) y x"
      using ext_Union_ops(2) [OF E(1) E(2) E(3)] ext_Union_ops(2) [OF E(1) E(3) E(2)]
            chain_mult_comm [OF E(1) E(2) E(3)] by simp
  qed
  show ?thesis
  proof unfold_locales
    fix x y z
    assume "x \<in> ecarrier (ext_Union C)" "y \<in> ecarrier (ext_Union C)" "z \<in> ecarrier (ext_Union C)"
    then obtain E where E: "E \<in> C" "x \<in> ecarrier E" "y \<in> ecarrier E" "z \<in> ecarrier E"
      using chain_common3 by blast
    have cl: "eadd E y z \<in> ecarrier E" "emult E x y \<in> ecarrier E" "emult E x z \<in> ecarrier E"
             "emult E y x \<in> ecarrier E" "emult E z x \<in> ecarrier E"
      using chain_add_closed [OF E(1)] chain_mult_closed [OF E(1)] E by auto
    show "emult (ext_Union C) x (eadd (ext_Union C) y z)
          = eadd (ext_Union C) (emult (ext_Union C) x y) (emult (ext_Union C) x z)"
      using cl E ext_Union_ops(1) [OF E(1)] ext_Union_ops(2) [OF E(1)]
            chain_distrib [OF E(1)] by simp
    show "emult (ext_Union C) (eadd (ext_Union C) y z) x
          = eadd (ext_Union C) (emult (ext_Union C) y x) (emult (ext_Union C) z x)"
      using cl E ext_Union_ops(1) [OF E(1)] ext_Union_ops(2) [OF E(1)]
            chain_distrib' [OF E(1)] by simp
  next
    \<comment> \<open>Taken through the definitions rather than from a member's \<open>nontrivial\<close>: the two
        statements are interchangeable, and @{locale Ring} does not itself assume \<open>\<one> \<noteq> \<zero>\<close>.\<close>
    show "\<one>\<^sub>I \<noteq> \<zero>\<^sub>I"
      using nz by (auto simp: ipoly_one_def ipoly_zero_def fun_eq_iff)
  next
    fix x assume x: "x \<in> ecarrier (ext_Union C)" and xnz: "x \<noteq> \<zero>\<^sub>I"
    from x obtain E where E: "E \<in> C" "x \<in> ecarrier E" by auto
    from chain_mult_inv [OF E(1) E(2) xnz] obtain y
      where y: "y \<in> ecarrier E" "emult E x y = \<one>\<^sub>I" "emult E y x = \<one>\<^sub>I" by blast
    have "emult (ext_Union C) x y = \<one>\<^sub>I" and "emult (ext_Union C) y x = \<one>\<^sub>I"
      using ext_Union_ops(2) [OF E(1) E(2) y(1)] ext_Union_ops(2) [OF E(1) y(1) E(2)] y by simp_all
    moreover have "y \<in> ecarrier (ext_Union C)" using E(1) y(1) by auto
    ultimately show "Umult.invertible x"
      by (blast intro: Umult.invertibleI)
  qed
qed

subsection \<open>Evaluation is the same in a member and in the union\<close>

text \<open>The remaining extension condition, @{const root_closed}, asserts that an indeterminate is a
  \<^emph>\<open>root\<close>, which is an equation about evaluation.  Evaluation does not transfer between a member and
  the union for free: @{const commutative_monoid.fincomp} depends on the carrier as well as the
  operation (through @{const commutative_monoid.M_ify}), so @{thm [source] fincomp_transfer} is what
  makes the two agree, given that every value involved stays inside the member.\<close>

lemma chain_Ring:
  assumes E: "E \<in> C" shows "Ring (ecarrier E) (eadd E) (emult E) \<zero>\<^sub>I \<one>\<^sub>I"
  using chain_field [OF E] by (simp add: Field_def commutative_ring_def)

lemma ext_Union_Ring:
  assumes ne: "C \<noteq> {}" and nz: "\<one> \<noteq> \<zero>"
  shows "Ring (ecarrier (ext_Union C)) (eadd (ext_Union C)) (emult (ext_Union C)) \<zero>\<^sub>I \<one>\<^sub>I"
  using ext_Union_field [OF ne nz] by (simp add: Field_def commutative_ring_def)

text \<open>The chain case is now just the ordering case at @{thm [source] ext_Union_upper_bound}.\<close>

lemma rpow_transfer:
  assumes ne: "C \<noteq> {}" and nz: "\<one> \<noteq> \<zero>" and E: "E \<in> C" and a: "a \<in> ecarrier E"
  shows "Ring.rpow (emult (ext_Union C)) \<one>\<^sub>I a n = Ring.rpow (emult E) \<one>\<^sub>I a n"
  by (rule ext_le_rpow [OF chain_Ring [OF E] ext_Union_Ring [OF ne nz]
                           ext_Union_upper_bound [OF E] a])

lemma ext_Union_eval:
  assumes ne: "C \<noteq> {}" and nz: "\<one> \<noteq> \<zero>" and E: "E \<in> C"
    and a: "a \<in> ecarrier E" and p: "\<And>k. p k \<in> ecarrier E"
  shows "eeval (ext_Union C) a p = eeval E a p"
  by (rule ext_le_eval [OF chain_Ring [OF E] ext_Union_Ring [OF ne nz]
                           ext_Union_upper_bound [OF E] a p])


subsection \<open>The union of a nonempty chain is an extension\<close>

lemma ext_Union_is_extension:
  assumes ne: "C \<noteq> {}" and nz: "\<one> \<noteq> \<zero>"
  shows "is_extension (ext_Union C)"
proof (rule is_extensionI)
  obtain E0 where E0: "E0 \<in> C" using ne by blast
  have ext0: "is_extension E0" using chain E0 by (rule ext_chainD_extension)
  show "Field (ecarrier (ext_Union C)) (eadd (ext_Union C)) (emult (ext_Union C)) \<zero>\<^sub>I \<one>\<^sub>I"
    by (rule ext_Union_field [OF ne nz])
  show "ecarrier (ext_Union C) \<subseteq> ipoly_carrier"
    using chain ext_chainD_extension is_extension_subset by (fastforce simp: ext_Union_def)
  show "\<And>a. a \<in> R \<Longrightarrow> ipoly_const a \<in> ecarrier (ext_Union C)"
    using E0 is_extension_const_mem [OF ext0] by auto
  show "\<And>a b. \<lbrakk> a \<in> R; b \<in> R \<rbrakk>
               \<Longrightarrow> eadd (ext_Union C) (ipoly_const a) (ipoly_const b) = ipoly_const (a + b)"
  proof -
    fix a b assume ab: "a \<in> R" "b \<in> R"
    have mem: "ipoly_const a \<in> ecarrier E0" "ipoly_const b \<in> ecarrier E0"
      using ab is_extension_const_mem [OF ext0] by simp_all
    show "eadd (ext_Union C) (ipoly_const a) (ipoly_const b) = ipoly_const (a + b)"
      using ext_Union_ops(1) [OF E0 mem(1) mem(2)]
            is_extension_const_add [OF ext0 ab(1) ab(2)] by simp
  qed
  show "\<And>a b. \<lbrakk> a \<in> R; b \<in> R \<rbrakk>
               \<Longrightarrow> emult (ext_Union C) (ipoly_const a) (ipoly_const b) = ipoly_const (a \<cdot> b)"
  proof -
    fix a b assume ab: "a \<in> R" "b \<in> R"
    have mem: "ipoly_const a \<in> ecarrier E0" "ipoly_const b \<in> ecarrier E0"
      using ab is_extension_const_mem [OF ext0] by simp_all
    show "emult (ext_Union C) (ipoly_const a) (ipoly_const b) = ipoly_const (a \<cdot> b)"
      using ext_Union_ops(2) [OF E0 mem(1) mem(2)]
            is_extension_const_mult [OF ext0 ab(1) ab(2)] by simp
  qed
  show "root_closed (ext_Union C)"
  proof (rule root_closedI)
    fix \<P> P i
    assume Pm: "\<P> \<in> ecarrier (ext_Union C)" and Pc: "P \<in> poly_carrier"
      and nif: "\<not> index_free \<P> (P, i)"
    from Pm obtain E where E: "E \<in> C" "\<P> \<in> ecarrier E" by auto
    have extE: "is_extension E" using chain E(1) by (rule ext_chainD_extension)
    have rc: "root_closed E" by (rule is_extension_root_closed [OF extE])
    have mem: "ivar (P, i) \<in> ecarrier E" by (rule root_closed_mem [OF rc E(2) Pc nif])
    have ev: "eeval E (ivar (P, i)) (lift_poly P) = \<zero>\<^sub>I"
      by (rule root_closed_eval [OF rc E(2) Pc nif])
    have coeff: "lift_poly P k \<in> ecarrier E" for k
      using Pc extE by (simp add: is_extension_const_mem poly_carrier_coeff_closed)
    have "eeval (ext_Union C) (ivar (P, i)) (lift_poly P) = eeval E (ivar (P, i)) (lift_poly P)"
      by (rule ext_Union_eval [OF ne nz E(1) mem coeff])
    then show "ivar (P, i) \<in> ecarrier (ext_Union C)
               \<and> eeval (ext_Union C) (ivar (P, i)) (lift_poly P) = \<zero>\<^sub>I"
      using mem E(1) ev by auto
  qed
  show "op_restricted (ecarrier (ext_Union C)) (eadd (ext_Union C))"
    by (rule ext_Union_restricted(1))
  show "op_restricted (ecarrier (ext_Union C)) (emult (ext_Union C))"
    by (rule ext_Union_restricted(2))
qed

end (* chain *)

end (* Ring *)


section \<open>Transporting a Field Structure along an Injection\<close>

context Field
begin

text \<open>A field structure transports along a map injective on the carrier, given operations on the
  image that make the map a homomorphism there.  Only the behaviour \<^emph>\<open>on the image\<close> is constrained,
  which is what makes the restricted operations of an extension free of charge: no separate lemma is
  needed to see that restricting a field's operations to its own carrier leaves a field.  The same
  lemma will serve when a root is adjoined, since that too realises a field as the image of an
  injection.\<close>
lemma field_image_transport:
  fixes h :: "'a \<Rightarrow> 'b" and hadd hmult :: "'b \<Rightarrow> 'b \<Rightarrow> 'b"
  assumes inj: "inj_on h R"
    and ha: "\<And>a b. \<lbrakk> a \<in> R; b \<in> R \<rbrakk> \<Longrightarrow> hadd (h a) (h b) = h (a + b)"
    and hm: "\<And>a b. \<lbrakk> a \<in> R; b \<in> R \<rbrakk> \<Longrightarrow> hmult (h a) (h b) = h (a \<cdot> b)"
  shows "Field (h ` R) hadd hmult (h \<zero>) (h \<one>)"
proof -
  have grp: "Group (h ` R) hadd (h \<zero>)"
  proof (rule GroupI)
    show "\<And>x y. \<lbrakk> x \<in> h ` R; y \<in> h ` R \<rbrakk> \<Longrightarrow> hadd x y \<in> h ` R"
      using ha by force
    show "h \<zero> \<in> h ` R" by simp
    show "\<And>x y z. \<lbrakk> x \<in> h ` R; y \<in> h ` R; z \<in> h ` R \<rbrakk>
                   \<Longrightarrow> hadd (hadd x y) z = hadd x (hadd y z)"
      using ha by (clarsimp simp: additive.associative)
    show "\<And>x. x \<in> h ` R \<Longrightarrow> hadd (h \<zero>) x = x" using ha by force
    show "\<And>x. x \<in> h ` R \<Longrightarrow> hadd x (h \<zero>) = x" using ha by force
    show "\<And>x. x \<in> h ` R \<Longrightarrow> \<exists>y \<in> h ` R. hadd x y = h \<zero> \<and> hadd y x = h \<zero>"
    proof -
      fix x assume "x \<in> h ` R"
      then obtain a where a: "a \<in> R" and xa: "x = h a" by blast
      then have na: "- a \<in> R" by (simp add: additive.invertible_inverse_closed)
      have "hadd (h a) (h (- a)) = h \<zero>"
        using ha [OF a na] a by (simp add: additive.invertible_right_inverse)
      moreover have "hadd (h (- a)) (h a) = h \<zero>"
        using ha [OF na a] a by (simp add: additive.invertible_left_inverse)
      ultimately show "\<exists>y \<in> h ` R. hadd x y = h \<zero> \<and> hadd y x = h \<zero>"
        using na xa by blast
    qed
  qed
  interpret hadd: Group "h ` R" hadd "h \<zero>" by (rule grp)
  interpret hadd: Abelian_Group "h ` R" hadd "h \<zero>"
  proof unfold_locales
    fix x y assume "x \<in> h ` R" and "y \<in> h ` R"
    then show "hadd x y = hadd y x"
      using ha by (clarsimp simp: additive.commutative)
  qed
  interpret hmult: commutative_monoid "h ` R" hmult "h \<one>"
  proof unfold_locales
    show "\<And>x y. \<lbrakk> x \<in> h ` R; y \<in> h ` R \<rbrakk> \<Longrightarrow> hmult x y \<in> h ` R"
      using hm by force
    show "h \<one> \<in> h ` R" by simp
    show "\<And>x y z. \<lbrakk> x \<in> h ` R; y \<in> h ` R; z \<in> h ` R \<rbrakk>
                   \<Longrightarrow> hmult (hmult x y) z = hmult x (hmult y z)"
      using hm by (clarsimp simp: multiplicative.associative)
    show "\<And>x. x \<in> h ` R \<Longrightarrow> hmult (h \<one>) x = x" using hm by force
    show "\<And>x. x \<in> h ` R \<Longrightarrow> hmult x (h \<one>) = x" using hm by force
    show "\<And>x y. \<lbrakk> x \<in> h ` R; y \<in> h ` R \<rbrakk> \<Longrightarrow> hmult x y = hmult y x"
      using hm by (clarsimp simp: multiplicative.commutative)
  qed
  have distrib: "\<And>x y z. \<lbrakk> x \<in> h ` R; y \<in> h ` R; z \<in> h ` R \<rbrakk>
                  \<Longrightarrow> hmult x (hadd y z) = hadd (hmult x y) (hmult x z)"
    using ha hm by (clarsimp simp: distributive)
  have distrib': "\<And>x y z. \<lbrakk> x \<in> h ` R; y \<in> h ` R; z \<in> h ` R \<rbrakk>
                   \<Longrightarrow> hmult (hadd y z) x = hadd (hmult y x) (hmult z x)"
    using ha hm by (clarsimp simp: distributive)
  have nz: "h \<one> \<noteq> h \<zero>"
    using inj nontrivial by (simp add: inj_on_eq_iff)
  show ?thesis
  proof unfold_locales
    show "\<And>x y z. \<lbrakk> x \<in> h ` R; y \<in> h ` R; z \<in> h ` R \<rbrakk>
                   \<Longrightarrow> hmult x (hadd y z) = hadd (hmult x y) (hmult x z)"
      by (rule distrib)
    show "\<And>x y z. \<lbrakk> x \<in> h ` R; y \<in> h ` R; z \<in> h ` R \<rbrakk>
                   \<Longrightarrow> hmult (hadd y z) x = hadd (hmult y x) (hmult z x)"
      by (rule distrib')
    show "h \<one> \<noteq> h \<zero>" by (rule nz)
    show "\<And>x. \<lbrakk> x \<in> h ` R; x \<noteq> h \<zero> \<rbrakk> \<Longrightarrow> hmult.invertible x"
    proof -
      fix x assume x: "x \<in> h ` R" and xnz: "x \<noteq> h \<zero>"
      then obtain a where a: "a \<in> R" and xa: "x = h a" by blast
      with xnz have anz: "a \<noteq> \<zero>" by blast
      have inv: "multiplicative.invertible a" by (rule field_inverse [OF a anz])
      have ia: "multiplicative.inverse a \<in> R"
        by (rule multiplicative.invertible_inverse_closed [OF inv a])
      have "hmult (h a) (h (multiplicative.inverse a)) = h \<one>"
        using hm [OF a ia] multiplicative.invertible_right_inverse [OF inv a] by simp
      moreover have "hmult (h (multiplicative.inverse a)) (h a) = h \<one>"
        using hm [OF ia a] multiplicative.invertible_left_inverse [OF inv a] by simp
      moreover have "h (multiplicative.inverse a) \<in> h ` R" using ia by simp
      ultimately show "hmult.invertible x"
        using xa by (blast intro: hmult.invertibleI)
    qed
  qed
qed


subsection \<open>The base extension is an extension\<close>

theorem is_extension_base_ext: "is_extension base_ext"
proof (rule is_extensionI)
  have "Field (ipoly_const ` R) (eadd base_ext) (emult base_ext) (ipoly_const \<zero>) (ipoly_const \<one>)"
    by (rule field_image_transport [OF ipoly_const_inj_on base_ext_add base_ext_mult])
  then show "Field (ecarrier base_ext) (eadd base_ext) (emult base_ext) \<zero>\<^sub>I \<one>\<^sub>I" by simp
  show "ecarrier base_ext \<subseteq> ipoly_carrier"
    using ipoly_const_closed by auto
  show "\<And>a. a \<in> R \<Longrightarrow> ipoly_const a \<in> ecarrier base_ext" by simp
  show "\<And>a b. \<lbrakk> a \<in> R; b \<in> R \<rbrakk>
               \<Longrightarrow> eadd base_ext (ipoly_const a) (ipoly_const b) = ipoly_const (a + b)"
    by (rule base_ext_add)
  show "\<And>a b. \<lbrakk> a \<in> R; b \<in> R \<rbrakk>
               \<Longrightarrow> emult base_ext (ipoly_const a) (ipoly_const b) = ipoly_const (a \<cdot> b)"
    by (rule base_ext_mult)
  show "root_closed base_ext"
    \<comment> \<open>Vacuous: every element is a constant, and a constant is index-free.\<close>
    by (rule root_closedI) auto
  show "op_restricted (ecarrier base_ext) (eadd base_ext)" by (rule base_ext_restricted(1))
  show "op_restricted (ecarrier base_ext) (emult base_ext)" by (rule base_ext_restricted(2))
qed

corollary extensions_non_empty: "extensions \<noteq> {}"
  using is_extension_base_ext by auto

subsection \<open>A maximal extension exists\<close>

text \<open>Zorn's lemma applies: the extensions form a set, partially ordered by @{const ext_le}, in which
  every chain has an upper bound --- the union of a nonempty chain, and @{const base_ext} for the
  empty one.  Maximality is what will force every polynomial over @{term R} to split, since an
  unsplit polynomial leaves an index free at which a root could be adjoined.\<close>
theorem exists_maximal_extension:
  "\<exists>M \<in> extensions. \<forall>L \<in> extensions. ext_le M L \<longrightarrow> L = M"
proof (rule predicate_Zorn [OF ext_partial_order])
  fix D assume D: "D \<in> Chains (relation_of ext_le extensions)"
  then have sub: "D \<subseteq> extensions" by (rule Chains_relation_of)
  have ch: "ext_chain D"
    using D sub unfolding ext_chain_def Chains_def relation_of_def by auto
  show "\<exists>u \<in> extensions. \<forall>a \<in> D. ext_le a u"
  proof (cases "D = {}")
    case True
    have "base_ext \<in> extensions" by (simp add: is_extension_base_ext)
    with True show ?thesis by blast
  next
    case False
    have "is_extension (ext_Union D)"
      by (rule ext_Union_is_extension [OF ch False nontrivial])
    moreover have "\<forall>a \<in> D. ext_le a (ext_Union D)"
      using ext_Union_upper_bound [OF ch] by blast
    ultimately show ?thesis by auto
  qed
qed

subsection \<open>A fresh index always exists\<close>

text \<open>Towards @{text exists_root}: for any nonzero polynomial @{term P} over @{term R} there is an
  index @{term i} that no element of a given extension involves.  This is the step that makes room
  for a new root, and it is where the choice of indexed polynomials as the ambient type pays off ---
  no cardinality argument is needed, only the observation that an extension \<^emph>\<open>mentioning\<close> every index
  would contain a root of @{term P} for each of them, and a nonzero polynomial over a field has only
  finitely many roots.\<close>
lemma exists_fresh_index:
  assumes M: "is_extension M" and P: "P \<in> poly_carrier" and Pnz: "P \<noteq> \<zero>\<^sub>P"
  shows "\<exists>i. \<forall>\<P> \<in> ecarrier M. index_free \<P> (P, i)"
proof (rule ccontr)
  assume "\<not> (\<exists>i. \<forall>\<P> \<in> ecarrier M. index_free \<P> (P, i))"
  then have bad: "\<exists>\<P> \<in> ecarrier M. \<not> index_free \<P> (P, i)" for i by blast
  interpret M: Field "ecarrier M" "eadd M" "emult M" "\<zero>\<^sub>I" "\<one>\<^sub>I"
    by (rule is_extension_field [OF M])
  have rc: "root_closed M" by (rule is_extension_root_closed [OF M])
  \<comment> \<open>Each index is realised, and its indeterminate is then a root of @{term P} in @{term M}.\<close>
  have root: "ivar (P, i) \<in> ecarrier M \<and> M.eval (ivar (P, i)) (lift_poly P) = \<zero>\<^sub>I" for i
  proof -
    obtain \<P> where "\<P> \<in> ecarrier M" and "\<not> index_free \<P> (P, i)" using bad by blast
    then show ?thesis
      using root_closed_mem [OF rc _ P] root_closed_eval [OF rc _ P] by blast
  qed
  \<comment> \<open>The lifted polynomial is a nonzero polynomial over @{term M}.\<close>
  have lc: "lift_poly P \<in> M.poly_carrier"
  proof (rule M.poly_carrierI)
    have "{k. lift_poly P k \<noteq> \<zero>\<^sub>I} \<subseteq> {k. P k \<noteq> \<zero>}"
      by (auto simp: lift_poly_def ipoly_const_def ipoly_zero_def)
    then show "finite {k. lift_poly P k \<noteq> \<zero>\<^sub>I}"
      using poly_carrier_finite [OF P] by (rule finite_subset)
    show "\<And>k. lift_poly P k \<in> ecarrier M"
      using P M by (simp add: is_extension_const_mem poly_carrier_coeff_closed)
  qed
  have lnz: "lift_poly P \<noteq> M.poly_zero"
  proof -
    obtain k where k: "P k \<noteq> \<zero>" using Pnz by (auto simp: poly_zero_def fun_eq_iff)
    then have "ipoly_const (P k) \<noteq> \<zero>\<^sub>I"
      by (metis ipoly_const_coeff ipoly_zero_def)
    then show ?thesis by (auto simp: lift_poly_def M.poly_zero_def fun_eq_iff)
  qed
  have fin: "finite {a \<in> ecarrier M. M.eval a (lift_poly P) = \<zero>\<^sub>I}"
    using M.card_roots_le_degree [OF lc lnz] by blast
  \<comment> \<open>Yet the root set contains an injective image of @{typ nat}.\<close>
  have inj: "inj (\<lambda>i. ivar (P, i) :: 'a ipoly)"
    using ivar_inj [OF nontrivial] by (auto simp: inj_on_def)
  have "range (\<lambda>i. ivar (P, i) :: 'a ipoly)
        \<subseteq> {a \<in> ecarrier M. M.eval a (lift_poly P) = \<zero>\<^sub>I}"
    using root by blast
  with fin inj show False
    by (meson finite_subset finite_imageD infinite_UNIV_nat)
qed

end (* field *)


subsection \<open>Transporting a field onto its image, with restricted operations\<close>

text \<open>An injective image of a field carries a field structure, and the operations obtained by
  \<^emph>\<open>transport\<close> --- undo the injection, operate, redo it --- are automatically the restricted ones an
  extension requires.  Nothing is assumed about how @{term h} interacts with the ambient operations,
  which is the point: an extension's addition need not be the ambient addition, and
  @{const Ring.is_extension} does not require it to be.  Choosing the operations by transport sidesteps
  the question instead of forcing a stronger definition.\<close>
lemma field_transport_restricted:
  fixes A :: "'b set" and add mult :: "'b \<Rightarrow> 'b \<Rightarrow> 'b" and z u :: 'b
    and h :: "'b \<Rightarrow> 'a ipoly"
  assumes F: "Field A add mult z u" and inj: "inj_on h A"
  defines "K \<equiv> h ` A"
    and "hadd \<equiv> (\<lambda>x y. if x \<in> h ` A \<and> y \<in> h ` A
                        then h (add (inv_into A h x) (inv_into A h y)) else undefined)"
    and "hmult \<equiv> (\<lambda>x y. if x \<in> h ` A \<and> y \<in> h ` A
                         then h (mult (inv_into A h x) (inv_into A h y)) else undefined)"
  shows field_transport_field: "Field K hadd hmult (h z) (h u)"
    and field_transport_add_restricted: "op_restricted K hadd"
    and field_transport_mult_restricted: "op_restricted K hmult"
proof -
  have undo: "inv_into A h (h a) = a" if "a \<in> A" for a
    using inj that by (rule inv_into_f_f)
  have ha: "hadd (h a) (h b) = h (add a b)" if "a \<in> A" "b \<in> A" for a b
    unfolding hadd_def using that undo by simp
  have hm: "hmult (h a) (h b) = h (mult a b)" if "a \<in> A" "b \<in> A" for a b
    unfolding hmult_def using that undo by simp
  show "Field K hadd hmult (h z) (h u)"
    unfolding K_def by (rule Field.field_image_transport [OF F inj ha hm])
  show "op_restricted K hadd"
    by (rule op_restrictedI) (auto simp: hadd_def K_def)
  show "op_restricted K hmult"
    by (rule op_restrictedI) (auto simp: hmult_def K_def)
qed



section \<open>Working Inside a Fixed Extension\<close>

text \<open>Adjoining a root needs the polynomial machinery of the extension's own coefficient field ---
  \<open>pmod\<close>, \<open>poly_carrier\<close>, \<open>degree\<close> at @{term "ecarrier M"}.  Fixing @{term M} in a locale and
  discharging @{locale Field} for it once, by @{thm [source] Ring.is_extension_field}, makes all of it
  available under the @{text M} prefix throughout, \<^emph>\<open>including inside definitions\<close>.
  @{command interpret} would not serve, being a proof-body command, but @{command sublocale} is its
  declaration-level counterpart, so no definition here has to spell out the five locale parameters.\<close>

locale field_extension = Field +
  fixes M :: "'a iext"
  assumes is_ext: "is_extension M"

sublocale field_extension \<subseteq> M: Field "ecarrier M" "eadd M" "emult M" "\<zero>\<^sub>I" "\<one>\<^sub>I"
  by (rule is_extension_field [OF is_ext])

context field_extension
begin

text \<open>The realisation map: reduce a polynomial over @{term M} modulo @{term Q}, then read the
  remainder off at the fresh indeterminate, using the \<^emph>\<open>ambient\<close> operations.  Both prefixes now read
  naturally.\<close>
definition realise :: "'a root_index \<Rightarrow> (nat \<Rightarrow> 'a ipoly) \<Rightarrow> (nat \<Rightarrow> 'a ipoly) \<Rightarrow> 'a ipoly"
  where "realise j Q S = ieval (ivar j) (M.pmod S Q)"

text \<open>A polynomial over @{term M} is also one over the ambient ring, its carrier being contained
  there.  Note that the two rings share their zero, so they also share @{term Ring.degree} and
  @{term Ring.poly_zero}: no translation of degrees is needed anywhere below.\<close>

lemma coeff_ipoly_closed: "S \<in> M.poly_carrier \<Longrightarrow> S k \<in> ipoly_carrier"
  using is_extension_subset [OF is_ext] M.poly_carrier_coeff_closed by blast

lemma low_poly_ambient:
  assumes S: "S \<in> M.low_poly d" shows "S \<in> Ring.poly_carrier ipoly_carrier \<zero>\<^sub>I"
proof (rule Ring.poly_carrierI [OF ipoly_ring])
  have Sc: "S \<in> M.poly_carrier" using S by (rule M.low_poly_closed)
  show "finite {i. S i \<noteq> \<zero>\<^sub>I}" using Sc by (rule M.poly_carrier_finite)
  show "\<And>i. S i \<in> ipoly_carrier" using Sc by (rule coeff_ipoly_closed)
qed

text \<open>On the remainders the realisation is a sum over the \<^emph>\<open>fixed\<close> range @{term "{..d}"} rather than
  over each polynomial's own degree.  A common range is what @{thm [source] ieval_ivar_inj} needs, and
  enlarging the range past the degree is harmless.\<close>
lemma ieval_low_fincomp:
  assumes S: "S \<in> M.low_poly d"
  shows "ieval (ivar j) S
       = commutative_monoid.fincomp ipoly_carrier (\<oplus>\<^sub>I) \<zero>\<^sub>I
           (\<lambda>k. S k \<otimes>\<^sub>I Ring.rpow (\<otimes>\<^sub>I) \<one>\<^sub>I (ivar j) k) {..d}"
proof (rule Ring.eval_fincomp_le [OF ipoly_ring low_poly_ambient [OF S] ivar_closed])
  have "S = M.poly_zero \<or> Ring.degree \<zero>\<^sub>I S < d"
    using S M.low_poly_iff_degree [OF M.low_poly_closed [OF S]] by blast
  then show "Ring.degree \<zero>\<^sub>I S \<le> d"
    using M.degree_zero by fastforce
qed

text \<open>\<^emph>\<open>The realisation is injective on the remainders.\<close>  This is the point of a \<^emph>\<open>fresh\<close> index: every
  coefficient lies in @{term M} and so is index-free at @{term j}, which is exactly the hypothesis
  under which @{thm [source] ieval_ivar_inj} reads the coefficients back off.  Above the range the two
  remainders agree trivially, both coefficients being zero.\<close>
lemma ieval_inj_on_low:
  assumes fresh: "\<And>\<P>. \<P> \<in> ecarrier M \<Longrightarrow> index_free \<P> j"
  shows "inj_on (ieval (ivar j)) (M.low_poly d)"
proof (rule inj_onI)
  fix S T
  assume S: "S \<in> M.low_poly d" and T: "T \<in> M.low_poly d"
    and eq: "ieval (ivar j) S = ieval (ivar j) T"
  have Sc: "S \<in> M.poly_carrier" and Tc: "T \<in> M.poly_carrier"
    using S T by (blast intro: M.low_poly_closed)+
  have Sip: "S k \<in> ipoly_carrier" and Tip: "T k \<in> ipoly_carrier" for k
    using Sc Tc by (blast intro: coeff_ipoly_closed)+
  have Sf: "index_free (S k) j" and Tf: "index_free (T k) j" for k
    using fresh Sc Tc by (blast intro: M.poly_carrier_coeff_closed)+
  have sums: "commutative_monoid.fincomp ipoly_carrier (\<oplus>\<^sub>I) \<zero>\<^sub>I
                (\<lambda>k. S k \<otimes>\<^sub>I Ring.rpow (\<otimes>\<^sub>I) \<one>\<^sub>I (ivar j) k) {..d}
            = commutative_monoid.fincomp ipoly_carrier (\<oplus>\<^sub>I) \<zero>\<^sub>I
                (\<lambda>k. T k \<otimes>\<^sub>I Ring.rpow (\<otimes>\<^sub>I) \<one>\<^sub>I (ivar j) k) {..d}"
    using ieval_low_fincomp [OF S] ieval_low_fincomp [OF T] eq by simp
  show "S = T"
  proof (rule ext)
    fix k
    show "S k = T k"
    proof (cases "k \<le> d")
      case True
      show ?thesis by (rule ieval_ivar_inj [OF Sip Sf Tip Tf sums True])
    next
      case False
      then have "S k = \<zero>\<^sub>I" and "T k = \<zero>\<^sub>I"
        using S T unfolding M.low_poly_def by auto
      then show ?thesis by simp
    qed
  qed
qed


text \<open>\<^emph>\<open>The extension obtained by adjoining a root.\<close>  The carrier is the image of the remainders
  modulo @{term Q} under evaluation at the fresh indeterminate; the operations are the transported
  ones.  Reduction modulo @{term Q} has to live in the multiplication, since the realisation of
  @{term Q} itself is not zero in the ambient ring --- which is exactly why an extension carries its
  own operations rather than inheriting the ambient ones.\<close>

definition adjoin_carrier :: "'a root_index \<Rightarrow> (nat \<Rightarrow> 'a ipoly) \<Rightarrow> 'a ipoly set"
  where "adjoin_carrier j Q = ieval (ivar j) ` M.low_poly (M.degree Q)"

definition adjoin :: "'a root_index \<Rightarrow> (nat \<Rightarrow> 'a ipoly) \<Rightarrow> 'a iext"
  where "adjoin j Q =
    (adjoin_carrier j Q,
     (\<lambda>x y. if x \<in> adjoin_carrier j Q \<and> y \<in> adjoin_carrier j Q
            then ieval (ivar j)
                   (M.poly_add (inv_into (M.low_poly (M.degree Q)) (ieval (ivar j)) x)
                               (inv_into (M.low_poly (M.degree Q)) (ieval (ivar j)) y))
            else undefined),
     (\<lambda>x y. if x \<in> adjoin_carrier j Q \<and> y \<in> adjoin_carrier j Q
            then ieval (ivar j)
                   (M.pmod (M.poly_mult
                              (inv_into (M.low_poly (M.degree Q)) (ieval (ivar j)) x)
                              (inv_into (M.low_poly (M.degree Q)) (ieval (ivar j)) y)) Q)
            else undefined))"

lemma adjoin_carrier_eq [simp]: "ecarrier (adjoin j Q) = adjoin_carrier j Q"
  by (simp add: adjoin_def)

text \<open>The field structure and the restrictedness of both operations come together, by transporting
  @{thm [source] Field.remainder_field} along the realisation, which
  @{thm [source] ieval_inj_on_low} shows to be injective on the remainders.  The zero and the unit
  land on @{term "\<zero>\<^sub>I"} and @{term "\<one>\<^sub>I"} because evaluation sends the zero and unit polynomials
  there.\<close>
text \<open>The realisation sends the zero, the unit and the variable of the polynomial ring over
  @{term M} to
  @{term "\<zero>\<^sub>I"}, @{term "\<one>\<^sub>I"} and the fresh indeterminate.  The first two are what make the
  transported field structure have the zero and unit that @{const is_extension} demands; the third is
  what exhibits @{term "ivar j"} as an element of the adjoined carrier.\<close>

lemma ieval_poly_zero: "ieval (ivar j) M.poly_zero = \<zero>\<^sub>I"
  by (rule Ring.eval_zero [OF ipoly_ring ivar_closed])

lemma ieval_poly_one: "ieval (ivar j) M.poly_one = \<one>\<^sub>I"
  by (rule Ring.eval_one [OF ipoly_ring ivar_closed])

lemma ieval_poly_var: "ieval (ivar j) M.var = ivar j"
  by (rule Ring.eval_var [OF ipoly_ring ivar_closed])

text \<open>Nontriviality of the ambient indexed ring, taken from @{term R} rather than from @{term M}:
  a statement about @{term "\<one>\<^sub>I"} and @{term "\<zero>\<^sub>I"} alone is generalised over the index type and so
  cannot be derived from a hypothesis where that type is pinned.\<close>
lemma ipoly_one_neq_zero: "(\<one>\<^sub>I :: 'a root_index multiset \<Rightarrow> 'a) \<noteq> \<zero>\<^sub>I"
proof -
  have one: "\<one> \<in> R" and zero: "\<zero> \<in> R" by simp_all
  have "(ipoly_const \<one> :: 'a root_index multiset \<Rightarrow> 'a) \<noteq> ipoly_const \<zero>"
    using inj_on_eq_iff [OF ipoly_const_inj_on one zero] nontrivial by simp
  then show ?thesis by simp
qed

lemma var_low:
  assumes d2: "2 \<le> M.degree Q" shows "M.var \<in> M.low_poly (M.degree Q)"
proof -
  have "M.degree M.var = 1" by (rule M.degree_var [OF ipoly_one_neq_zero])
  with d2 show ?thesis using M.var_closed by (simp add: M.low_poly_iff_degree)
qed

text \<open>The constants of @{term M} sit inside the adjoined carrier, realised by the constant
  polynomials, and the transported operations restrict to @{term M}'s own there.  So @{term M} lies
  below the adjoined extension in the ordering --- which is what carries @{term M}'s root witnesses
  upwards, by @{thm [source] Ring.ext_le_eval}.\<close>

lemma M_Ring: "Ring (ecarrier M) (eadd M) (emult M) \<zero>\<^sub>I \<one>\<^sub>I"
  using is_extension_field [OF is_ext] by (simp add: Field_def commutative_ring_def)

lemma adjoin_rep:
  assumes fresh: "\<And>\<P>. \<P> \<in> ecarrier M \<Longrightarrow> index_free \<P> j"
    and S: "S \<in> M.low_poly (M.degree Q)"
  shows "inv_into (M.low_poly (M.degree Q)) (ieval (ivar j)) (ieval (ivar j) S) = S"
  using ieval_inj_on_low [OF fresh] S by (rule inv_into_f_f)

lemma ieval_poly_const:
  assumes y: "y \<in> ipoly_carrier" shows "ieval (ivar j) (M.poly_const y) = y"
  by (rule Ring.eval_const [OF ipoly_ring ivar_closed y])

lemma const_low:
  assumes irr: "M.poly_irreducible Q" and y: "y \<in> ecarrier M"
  shows "M.poly_const y \<in> M.low_poly (M.degree Q)"
proof -
  have dpos: "0 < M.degree Q" using irr by (rule M.poly_irreducible_degree_pos)
  have c: "M.poly_const y \<in> M.poly_carrier" using y by (rule M.poly_const_closed)
  have "M.degree (M.poly_const y) = 0" using M.degree_const_le by (simp add: le_zero_eq)
  with dpos show ?thesis using c by (simp add: M.low_poly_iff_degree)
qed

lemma const_rep:
  assumes fresh: "\<And>\<P>. \<P> \<in> ecarrier M \<Longrightarrow> index_free \<P> j"
    and irr: "M.poly_irreducible Q" and y: "y \<in> ecarrier M"
  shows "inv_into (M.low_poly (M.degree Q)) (ieval (ivar j)) y = M.poly_const y"
proof -
  have yip: "y \<in> ipoly_carrier" using is_ext y by (rule is_extension_carrier_closed)
  have "inv_into (M.low_poly (M.degree Q)) (ieval (ivar j)) (ieval (ivar j) (M.poly_const y))
        = M.poly_const y"
    by (rule adjoin_rep [OF fresh const_low [OF irr y]])
  then show ?thesis using ieval_poly_const [OF yip] by simp
qed

lemma ecarrier_subset_adjoin:
  assumes fresh: "\<And>\<P>. \<P> \<in> ecarrier M \<Longrightarrow> index_free \<P> j"
    and irr: "M.poly_irreducible Q"
  shows "ecarrier M \<subseteq> adjoin_carrier j Q"
proof
  fix y assume y: "y \<in> ecarrier M"
  have yip: "y \<in> ipoly_carrier" using is_ext y by (rule is_extension_carrier_closed)
  have "y = ieval (ivar j) (M.poly_const y)" using ieval_poly_const [OF yip] by simp
  then show "y \<in> adjoin_carrier j Q"
    unfolding adjoin_carrier_def using const_low [OF irr y] by blast
qed

lemma ext_le_adjoin:
  assumes fresh: "\<And>\<P>. \<P> \<in> ecarrier M \<Longrightarrow> index_free \<P> j"
    and irr: "M.poly_irreducible Q"
  shows "ext_le M (adjoin j Q)"
proof (rule ext_leI)
  show "ecarrier M \<subseteq> ecarrier (adjoin j Q)"
    using ecarrier_subset_adjoin [OF fresh irr] by simp
next
  fix y y' assume y: "y \<in> ecarrier M" and y': "y' \<in> ecarrier M"
  have K: "y \<in> adjoin_carrier j Q" "y' \<in> adjoin_carrier j Q"
    using ecarrier_subset_adjoin [OF fresh irr] y y' by blast+
  have ry: "inv_into (M.low_poly (M.degree Q)) (ieval (ivar j)) y = M.poly_const y"
    and ry': "inv_into (M.low_poly (M.degree Q)) (ieval (ivar j)) y' = M.poly_const y'"
    using const_rep [OF fresh irr y] const_rep [OF fresh irr y'] by blast+
  have sum: "eadd M y y' \<in> ecarrier M" using M.additive.composition_closed y y' by simp
  have "eadd (adjoin j Q) y y'
        = ieval (ivar j) (M.poly_add (M.poly_const y) (M.poly_const y'))"
    unfolding adjoin_def using K ry ry' by simp
  also have "M.poly_add (M.poly_const y) (M.poly_const y') = M.poly_const (eadd M y y')"
    by (rule M.poly_const_add [OF y y'])
  also have "ieval (ivar j) (M.poly_const (eadd M y y')) = eadd M y y'"
    using is_extension_carrier_closed [OF is_ext sum] by (rule ieval_poly_const)
  finally show "eadd M y y' = eadd (adjoin j Q) y y'" by simp
next
  fix y y' assume y: "y \<in> ecarrier M" and y': "y' \<in> ecarrier M"
  have K: "y \<in> adjoin_carrier j Q" "y' \<in> adjoin_carrier j Q"
    using ecarrier_subset_adjoin [OF fresh irr] y y' by blast+
  have ry: "inv_into (M.low_poly (M.degree Q)) (ieval (ivar j)) y = M.poly_const y"
    and ry': "inv_into (M.low_poly (M.degree Q)) (ieval (ivar j)) y' = M.poly_const y'"
    using const_rep [OF fresh irr y] const_rep [OF fresh irr y'] by blast+
  have prod: "emult M y y' \<in> ecarrier M" using M.multiplicative.composition_closed y y' by simp
  have Qc: "Q \<in> M.poly_carrier" using irr by (rule M.poly_irreducibleD_carrier)
  have Qnz: "Q \<noteq> M.poly_zero" using irr by (rule M.poly_irreducibleD_nonzero)
  have "emult (adjoin j Q) y y'
        = ieval (ivar j)
            (M.pmod (M.poly_mult (M.poly_const y) (M.poly_const y')) Q)"
    unfolding adjoin_def using K ry ry' by simp
  also have "M.poly_mult (M.poly_const y) (M.poly_const y') = M.poly_const (emult M y y')"
    by (rule M.poly_const_mult [OF y y'])
  also have "M.pmod (M.poly_const (emult M y y')) Q = M.poly_const (emult M y y')"
  proof (rule M.pmod_small [OF Qc Qnz M.poly_const_closed [OF prod]])
    have "M.degree (M.poly_const (emult M y y')) = 0"
      using M.degree_const_le by (simp add: le_zero_eq)
    then show "M.poly_const (emult M y y') = M.poly_zero
               \<or> M.degree (M.poly_const (emult M y y')) < M.degree Q"
      using M.poly_irreducible_degree_pos [OF irr] by simp
  qed
  also have "ieval (ivar j) (M.poly_const (emult M y y')) = emult M y y'"
    using is_extension_carrier_closed [OF is_ext prod] by (rule ieval_poly_const)
  finally show "emult M y y' = emult (adjoin j Q) y y'" by simp
qed

lemma adjoin_field:
  assumes fresh: "\<And>\<P>. \<P> \<in> ecarrier M \<Longrightarrow> index_free \<P> j"
    and irr: "M.poly_irreducible Q"
  shows "Field (ecarrier (adjoin j Q)) (eadd (adjoin j Q)) (emult (adjoin j Q))
               (ieval (ivar j) M.poly_zero) (ieval (ivar j) M.poly_one)"
    and "op_restricted (ecarrier (adjoin j Q)) (eadd (adjoin j Q))"
    and "op_restricted (ecarrier (adjoin j Q)) (emult (adjoin j Q))"
  using field_transport_restricted
          [OF M.remainder_field [OF irr] ieval_inj_on_low [OF fresh]]
  by (simp_all add: adjoin_def adjoin_carrier_def)

text \<open>The adjoined field, with the zero and unit @{const is_extension} demands.\<close>
lemma adjoin_field_zero_one:
  assumes fresh: "\<And>\<P>. \<P> \<in> ecarrier M \<Longrightarrow> index_free \<P> j"
    and irr: "M.poly_irreducible Q"
  shows "Field (ecarrier (adjoin j Q)) (eadd (adjoin j Q)) (emult (adjoin j Q))
               \<zero>\<^sub>I \<one>\<^sub>I"
  using adjoin_field (1) [OF fresh irr] ieval_poly_zero ieval_poly_one by simp

lemma adjoin_Ring:
  assumes fresh: "\<And>\<P>. \<P> \<in> ecarrier M \<Longrightarrow> index_free \<P> j"
    and irr: "M.poly_irreducible Q"
  shows "Ring (ecarrier (adjoin j Q)) (eadd (adjoin j Q)) (emult (adjoin j Q))
              \<zero>\<^sub>I \<one>\<^sub>I"
  using adjoin_field_zero_one [OF fresh irr] by (simp add: Field_def commutative_ring_def)

lemma lift_poly_M_carrier:
  assumes P: "P \<in> poly_carrier" shows "lift_poly P \<in> M.poly_carrier"
proof (rule M.poly_carrierI)
  have "{k. lift_poly P k \<noteq> \<zero>\<^sub>I} \<subseteq> {k. P k \<noteq> \<zero>}"
    by (auto simp: lift_poly_def ipoly_const_def ipoly_zero_def)
  then show "finite {k. lift_poly P k \<noteq> \<zero>\<^sub>I}"
    using poly_carrier_finite [OF P] by (rule finite_subset)
  show "\<And>k. lift_poly P k \<in> ecarrier M"
    using P is_ext by (simp add: is_extension_const_mem poly_carrier_coeff_closed)
qed

text \<open>\<^emph>\<open>Root-closedness at the adjoined index itself.\<close>  The fresh indeterminate is the realisation of
  the variable, so it lies in the carrier once the modulus has degree at least two.  And it is a root:
  @{thm [source] eval_transport} moves the evaluation into the field of remainders, where
  @{thm [source] eval_remainder_at_var} identifies it with the reduction of the polynomial --- which
  vanishes precisely because the modulus divides it.\<close>
lemma root_closed_adjoin_self:
  assumes fresh: "\<And>\<P>. \<P> \<in> ecarrier M \<Longrightarrow> index_free \<P> j"
    and irr: "M.poly_irreducible Q"
    and dvd: "M.poly_dvd Q (lift_poly (fst j))"
    and Pj: "fst j \<in> poly_carrier"
    and d2: "2 \<le> M.degree Q"
  shows "ivar j \<in> ecarrier (adjoin j Q)
       \<and> eeval (adjoin j Q) (ivar j) (lift_poly (fst j)) = \<zero>\<^sub>I"
proof -
  have varlow: "M.var \<in> M.low_poly (M.degree Q)" by (rule var_low [OF d2])
  have "ivar j = ieval (ivar j) M.var" by (rule ieval_poly_var [symmetric])
  then have "ivar j \<in> ieval (ivar j) ` M.low_poly (M.degree Q)" using varlow by blast
  then have mem: "ivar j \<in> ecarrier (adjoin j Q)" by (simp add: adjoin_carrier_def)
  have RA: "Ring (M.low_poly (M.degree Q)) (M.poly_add)
              (\<lambda>S T. M.pmod (M.poly_mult S T) Q) M.poly_zero M.poly_one"
    using M.remainder_field [OF irr] by (simp add: Field_def commutative_ring_def)
  have RK: "Ring (ieval (ivar j) ` M.low_poly (M.degree Q))
              (eadd (adjoin j Q)) (emult (adjoin j Q))
              (ieval (ivar j) M.poly_zero) (ieval (ivar j) M.poly_one)"
    using adjoin_Ring [OF fresh irr] ieval_poly_zero ieval_poly_one
    by (simp add: adjoin_carrier_def)
  \<comment> \<open>The transported operations agree with the adjoined ones on realisations.\<close>
  have ha: "ieval (ivar j) (M.poly_add S T)
            = eadd (adjoin j Q) (ieval (ivar j) S) (ieval (ivar j) T)"
    if ST: "S \<in> M.low_poly (M.degree Q)" "T \<in> M.low_poly (M.degree Q)" for S T
    unfolding adjoin_def
    using ST adjoin_rep [OF fresh ST(1)] adjoin_rep [OF fresh ST(2)]
    by (simp add: adjoin_carrier_def)
  have hm: "ieval (ivar j) (M.pmod (M.poly_mult S T) Q)
            = emult (adjoin j Q) (ieval (ivar j) S) (ieval (ivar j) T)"
    if ST: "S \<in> M.low_poly (M.degree Q)" "T \<in> M.low_poly (M.degree Q)" for S T
    unfolding adjoin_def
    using ST adjoin_rep [OF fresh ST(1)] adjoin_rep [OF fresh ST(2)]
    by (simp add: adjoin_carrier_def)
  have liftc: "lift_poly (fst j) \<in> M.poly_carrier" by (rule lift_poly_M_carrier [OF Pj])
  have coeffM: "lift_poly (fst j) k \<in> ecarrier M" for k
    using liftc by (rule M.poly_carrier_coeff_closed)
  have constlow: "M.poly_const (lift_poly (fst j) k) \<in> M.low_poly (M.degree Q)" for k
    using const_low [OF irr coeffM] .
  have hconst: "ieval (ivar j) (M.poly_const (lift_poly (fst j) k)) = lift_poly (fst j) k" for k
    using ieval_poly_const [OF is_extension_carrier_closed [OF is_ext coeffM]] .
  have hfun: "(\<lambda>k. ieval (ivar j) (M.poly_const (lift_poly (fst j) k))) = lift_poly (fst j)"
    by (rule ext) (rule hconst)
  note transport =
    eval_transport [OF RA RK ha hm ieval_inj_on_low [OF fresh] varlow constlow]
  note evalrem = M.eval_remainder_at_var [OF irr d2 liftc]
  have pmodz: "M.pmod (lift_poly (fst j)) Q = M.poly_zero"
    using dvd M.poly_dvd_iff_pmod_zero
            [OF M.poly_irreducibleD_carrier [OF irr] M.poly_irreducibleD_nonzero [OF irr] liftc]
    by simp
  \<comment> \<open>Move the evaluation into the remainder field, reduce, and come back.\<close>
  have step1: "eeval (adjoin j Q) (ivar j) (lift_poly (fst j))
        = Ring.eval (ieval (ivar j) ` M.low_poly (M.degree Q))
            (eadd (adjoin j Q)) (emult (adjoin j Q))
            (ieval (ivar j) M.poly_zero) (ieval (ivar j) M.poly_one)
            (ieval (ivar j) M.var)
            (\<lambda>k. ieval (ivar j) (M.poly_const (lift_poly (fst j) k)))"
    unfolding adjoin_carrier_eq adjoin_carrier_def hfun
      ieval_poly_zero ieval_poly_one ieval_poly_var
    by rule
  have "eeval (adjoin j Q) (ivar j) (lift_poly (fst j))
        = ieval (ivar j)
            (Ring.eval (M.low_poly (M.degree Q)) (M.poly_add)
               (\<lambda>S T. M.pmod (M.poly_mult S T) Q) M.poly_zero M.poly_one
               M.var (\<lambda>k. M.poly_const (lift_poly (fst j) k)))"
    unfolding step1 by (rule transport)
  also have "\<dots> = ieval (ivar j) M.poly_zero" using evalrem pmodz by simp
  also have "\<dots> = \<zero>\<^sub>I" by (rule ieval_poly_zero)
  finally have "eeval (adjoin j Q) (ivar j) (lift_poly (fst j)) = \<zero>\<^sub>I" .
  with mem show ?thesis by blast
qed

text \<open>\<^emph>\<open>Root-closedness at an index other than the adjoined one.\<close>  An element of the adjoined carrier
  that involves such an index must have a coefficient involving it --- removing copies of the adjoined
  index cannot remove a different one --- and that coefficient lies in @{term M}, where
  root-closedness applies.  @{thm [source] Ring.ext_le_eval} then carries the root upwards.\<close>
lemma root_closed_adjoin_other:
  assumes fresh: "\<And>\<P>. \<P> \<in> ecarrier M \<Longrightarrow> index_free \<P> j"
    and irr: "M.poly_irreducible Q"
    and S: "S \<in> M.low_poly (M.degree Q)"
    and P': "P' \<in> poly_carrier" and ne: "(P', i') \<noteq> j"
    and nf: "\<not> index_free (ieval (ivar j) S) (P', i')"
  shows "ivar (P', i') \<in> ecarrier (adjoin j Q)
       \<and> eeval (adjoin j Q) (ivar (P', i')) (lift_poly P') = \<zero>\<^sub>I"
proof -
  have Sc: "S \<in> M.poly_carrier" using S by (rule M.low_poly_closed)
  have Sip: "S k \<in> ipoly_carrier" for k using Sc by (rule coeff_ipoly_closed)
  have SM: "S k \<in> ecarrier M" for k using Sc by (rule M.poly_carrier_coeff_closed)
  have Sf: "index_free (S k) j" for k using fresh SM by blast
  obtain m where m: "(P', i') \<in># m" and nz: "ieval (ivar j) S m \<noteq> \<zero>"
    using nf unfolding index_free_def by blast
  have val: "ieval (ivar j) S m
             = (if count m j \<le> M.degree Q
                then S (count m j) (m - replicate_mset (count m j) j) else \<zero>)"
    using ieval_low_fincomp [OF S] ieval_ivar [OF Sip Sf] by simp
  with nz have cnz: "S (count m j) (m - replicate_mset (count m j) j) \<noteq> \<zero>"
    by (auto split: if_split_asm)
  have inm: "(P', i') \<in># m - replicate_mset (count m j) j"
    using m ne by (simp add: in_diff_count count_replicate_mset)
  then have nfS: "\<not> index_free (S (count m j)) (P', i')"
    using cnz unfolding index_free_def by blast
  have rc: "root_closed M" using is_ext by (rule is_extension_root_closed)
  have mem: "ivar (P', i') \<in> ecarrier M" by (rule root_closed_mem [OF rc SM P' nfS])
  have rootM: "eeval M (ivar (P', i')) (lift_poly P') = \<zero>\<^sub>I"
    by (rule root_closed_eval [OF rc SM P' nfS])
  have "eeval (adjoin j Q) (ivar (P', i')) (lift_poly P')
        = eeval M (ivar (P', i')) (lift_poly P')"
  proof (rule ext_le_eval [OF M_Ring adjoin_Ring [OF fresh irr] ext_le_adjoin [OF fresh irr] mem])
    show "\<And>k. lift_poly P' k \<in> ecarrier M"
      using P' is_extension_const_mem [OF is_ext] poly_carrier_coeff_closed by simp
  qed
  with rootM mem ecarrier_subset_adjoin [OF fresh irr] show ?thesis by auto
qed


text \<open>\<^emph>\<open>The adjoined extension is root-closed.\<close>  The two cases above, joined by the observation that
  the adjoined index can only be involved at all when the modulus is nonlinear: were its degree at most
  one the remainders would be constants, so every element of the carrier would lie in @{term M} and be
  index-free at the fresh index by freshness.\<close>
lemma root_closed_adjoin:
  assumes fresh: "\<And>\<P>. \<P> \<in> ecarrier M \<Longrightarrow> index_free \<P> j"
    and irr: "M.poly_irreducible Q"
    and dvd: "M.poly_dvd Q (lift_poly (fst j))"
    and Pj: "fst j \<in> poly_carrier"
  shows "root_closed (adjoin j Q)"
proof (rule root_closedI)
  fix \<P> P' i'
  assume Pmem: "\<P> \<in> ecarrier (adjoin j Q)" and P': "P' \<in> poly_carrier"
    and nf: "\<not> index_free \<P> (P', i')"
  obtain S where S: "S \<in> M.low_poly (M.degree Q)" and Peq: "\<P> = ieval (ivar j) S"
    using Pmem unfolding adjoin_carrier_eq adjoin_carrier_def by blast
  show "ivar (P', i') \<in> ecarrier (adjoin j Q)
        \<and> eeval (adjoin j Q) (ivar (P', i')) (lift_poly P') = \<zero>\<^sub>I"
  proof (cases "(P', i') = j")
    case False
    show ?thesis
      using root_closed_adjoin_other [OF fresh irr S P' False] nf Peq by simp
  next
    case True
    \<comment> \<open>A linear modulus leaves only constants, which are index-free at the fresh index.\<close>
    have d2: "2 \<le> M.degree Q"
    proof (rule ccontr)
      assume "\<not> 2 \<le> M.degree Q"
      then have d1: "M.degree Q \<le> 1" by simp
      have Sc: "S \<in> M.poly_carrier" using S by (rule M.low_poly_closed)
      have "S = M.poly_zero \<or> M.degree S < M.degree Q"
        using S M.low_poly_iff_degree [OF Sc] by blast
      then have dS: "M.degree S = 0" using d1 M.degree_zero by fastforce
      have "S = M.poly_const (S 0)" by (rule M.degree_zero_imp_const [OF Sc dS])
      moreover have "S 0 \<in> ecarrier M" using Sc by (rule M.poly_carrier_coeff_closed)
      ultimately have "\<P> = S 0"
        using Peq ieval_poly_const [OF is_extension_carrier_closed [OF is_ext]] by metis
      then have "index_free \<P> j" using fresh \<open>S 0 \<in> ecarrier M\<close> by simp
      with nf True show False by simp
    qed
    have Pfst: "P' = fst j" using True by (metis fst_conv)
    show ?thesis
      using root_closed_adjoin_self [OF fresh irr dvd Pj d2] True Pfst by simp
  qed
qed


text \<open>\<^emph>\<open>The adjoined triple is an extension.\<close>  Everything is now in place: the field structure and the
  restrictedness of both operations come from the transport, root-closedness from the two cases above,
  and the conditions on the constants from the fact that @{term M} lies below, its own agreement with
  @{term R} on constants carrying over.\<close>
theorem is_extension_adjoin:
  assumes fresh: "\<And>\<P>. \<P> \<in> ecarrier M \<Longrightarrow> index_free \<P> j"
    and irr: "M.poly_irreducible Q"
    and dvd: "M.poly_dvd Q (lift_poly (fst j))"
    and Pj: "fst j \<in> poly_carrier"
  shows "is_extension (adjoin j Q)"
proof (rule is_extensionI)
  show "Field (ecarrier (adjoin j Q)) (eadd (adjoin j Q)) (emult (adjoin j Q)) \<zero>\<^sub>I \<one>\<^sub>I"
    by (rule adjoin_field_zero_one [OF fresh irr])
  show "ecarrier (adjoin j Q) \<subseteq> ipoly_carrier"
  proof
    fix y assume "y \<in> ecarrier (adjoin j Q)"
    then obtain S where S: "S \<in> M.low_poly (M.degree Q)" and yeq: "y = ieval (ivar j) S"
      unfolding adjoin_carrier_eq adjoin_carrier_def by blast
    show "y \<in> ipoly_carrier"
      using yeq Ring.eval_closed [OF ipoly_ring low_poly_ambient [OF S] ivar_closed] by simp
  qed
next
  fix a assume a: "a \<in> R"
  have "ipoly_const a \<in> ecarrier M" using is_ext a by (rule is_extension_const_mem)
  then have "ipoly_const a \<in> adjoin_carrier j Q"
    using ecarrier_subset_adjoin [OF fresh irr] by blast
  then show "ipoly_const a \<in> ecarrier (adjoin j Q)" by simp
next
  fix a b assume a: "a \<in> R" and b: "b \<in> R"
  have mem: "ipoly_const a \<in> ecarrier M" "ipoly_const b \<in> ecarrier M"
    using is_ext a b by (blast intro: is_extension_const_mem)+
  have "eadd (adjoin j Q) (ipoly_const a) (ipoly_const b)
        = eadd M (ipoly_const a) (ipoly_const b)"
    by (rule ext_le_add [OF ext_le_adjoin [OF fresh irr] mem(1) mem(2), symmetric])
  also have "\<dots> = ipoly_const (a + b)" using is_ext a b by (rule is_extension_const_add)
  finally show "eadd (adjoin j Q) (ipoly_const a) (ipoly_const b) = ipoly_const (a + b)" .
next
  fix a b assume a: "a \<in> R" and b: "b \<in> R"
  have mem: "ipoly_const a \<in> ecarrier M" "ipoly_const b \<in> ecarrier M"
    using is_ext a b by (blast intro: is_extension_const_mem)+
  have "emult (adjoin j Q) (ipoly_const a) (ipoly_const b)
        = emult M (ipoly_const a) (ipoly_const b)"
    by (rule ext_le_mult [OF ext_le_adjoin [OF fresh irr] mem(1) mem(2), symmetric])
  also have "\<dots> = ipoly_const (a \<cdot> b)" using is_ext a b by (rule is_extension_const_mult)
  finally show "emult (adjoin j Q) (ipoly_const a) (ipoly_const b) = ipoly_const (a \<cdot> b)" .
next
  show "root_closed (adjoin j Q)" by (rule root_closed_adjoin [OF fresh irr dvd Pj])
next
  show "op_restricted (ecarrier (adjoin j Q)) (eadd (adjoin j Q))"
    by (rule adjoin_field (2) [OF fresh irr])
next
  show "op_restricted (ecarrier (adjoin j Q)) (emult (adjoin j Q))"
    by (rule adjoin_field (3) [OF fresh irr])
qed

text \<open>And it is \<^emph>\<open>strictly\<close> larger: the fresh indeterminate involves its own index, whereas every
  element of @{term M} is index-free there.\<close>
lemma adjoin_strictly_larger:
  assumes fresh: "\<And>\<P>. \<P> \<in> ecarrier M \<Longrightarrow> index_free \<P> j"
    and irr: "M.poly_irreducible Q" and d2: "2 \<le> M.degree Q"
  shows "adjoin j Q \<noteq> M"
proof -
  have "ivar j = ieval (ivar j) M.var" by (rule ieval_poly_var [symmetric])
  then have "ivar j \<in> ieval (ivar j) ` M.low_poly (M.degree Q)"
    using var_low [OF d2] by blast
  then have inC: "ivar j \<in> ecarrier (adjoin j Q)" by (simp add: adjoin_carrier_def)
  have notinM: "ivar j \<notin> ecarrier M"
  proof
    assume "ivar j \<in> ecarrier M"
    then have "index_free (ivar j) j" by (rule fresh)
    with not_index_free_ivar [OF nontrivial, of j] show False by simp
  qed
  show ?thesis
  proof
    assume eq: "adjoin j Q = M"
    have "ivar j \<in> ecarrier M" using inC eq by simp
    with notinM show False ..
  qed
qed


subsection \<open>Every polynomial over the base field splits in a maximal extension\<close>

text \<open>\<^emph>\<open>The point of maximality.\<close>  Factor the lifted polynomial into irreducibles over @{term M}.  A
  factor of degree two or more would let a root of \<^emph>\<open>it\<close> be adjoined at a fresh index --- giving a
  strictly larger extension, which maximality forbids.  So every factor is linear, and a product of
  linear factors splits.

  Note where each earlier piece enters: @{thm [source] exists_fresh_index} supplies the index,
  @{thm [source] is_extension_adjoin} and @{thm [source] ext_le_adjoin} make the enlargement an
  extension above @{term M}, @{thm [source] adjoin_strictly_larger} contradicts maximality, and
  @{thm [source] Field.degree_one_splits} with @{thm [source] Field.splits_poly_prod} assembles the
  conclusion.\<close>
theorem exists_root:
  assumes max: "\<And>L. \<lbrakk> is_extension L; ext_le M L \<rbrakk> \<Longrightarrow> L = M"
    and P: "P \<in> poly_carrier"
  shows "M.splits (lift_poly P)"
proof -
  have liftc: "lift_poly P \<in> M.poly_carrier" by (rule lift_poly_M_carrier [OF P])
  show ?thesis
  proof (cases "lift_poly P = M.poly_zero")
    case True
    then show ?thesis by (simp add: M.splits_zero)
  next
    case nz: False
    show ?thesis
    proof (cases "M.poly_unit (lift_poly P)")
      case True
      then have "lift_poly P = M.poly_const (lift_poly P 0)"
        using M.poly_unit_imp_const by blast
      moreover have "lift_poly P 0 \<in> ecarrier M"
        using liftc by (rule M.poly_carrier_coeff_closed)
      ultimately show ?thesis using M.splits_const by metis
    next
      case nu: False
      obtain fs where firr: "\<And>f. f \<in> set fs \<Longrightarrow> M.poly_irreducible f"
        and prod: "lift_poly P = M.poly_prod fs"
        using M.factorization_into_irreducibles [OF liftc nz nu] by blast
      have fc: "f \<in> M.poly_carrier" if "f \<in> set fs" for f
        using firr [OF that] by (rule M.poly_irreducibleD_carrier)
      have Pnz: "P \<noteq> \<zero>\<^sub>P"
      proof
        assume "P = \<zero>\<^sub>P"
        then have "lift_poly P = M.poly_zero"
          by (simp add: lift_poly_def poly_zero_def M.poly_zero_def)
        with nz show False ..
      qed
      \<comment> \<open>No factor can have degree two or more.\<close>
      have deg1: "M.degree f = 1" if f: "f \<in> set fs" for f
      proof (rule ccontr)
        assume "M.degree f \<noteq> 1"
        moreover have "0 < M.degree f"
          using firr [OF f] by (rule M.poly_irreducible_degree_pos)
        ultimately have d2: "2 \<le> M.degree f" by simp
        obtain i where fresh: "\<And>\<P>. \<P> \<in> ecarrier M \<Longrightarrow> index_free \<P> (P, i)"
          using exists_fresh_index [OF is_ext P Pnz] by blast
        have dvd: "M.poly_dvd f (lift_poly (fst (P, i)))"
          using prod M.poly_dvd_poly_prod [OF fc f] by simp
        have Pj: "fst (P, i) \<in> poly_carrier" using P by simp
        have "is_extension (adjoin (P, i) f)"
          by (rule is_extension_adjoin [OF fresh firr [OF f] dvd Pj])
        moreover have "ext_le M (adjoin (P, i) f)"
          by (rule ext_le_adjoin [OF fresh firr [OF f]])
        ultimately have "adjoin (P, i) f = M" by (rule max)
        moreover have "adjoin (P, i) f \<noteq> M"
          by (rule adjoin_strictly_larger [OF fresh firr [OF f] d2])
        ultimately show False by simp
      qed
      have "M.splits f" if "f \<in> set fs" for f
        by (rule M.degree_one_splits [OF fc [OF that] deg1 [OF that]])
      then show ?thesis using prod M.splits_poly_prod by simp
    qed
  qed
qed

end


section \<open>An Extension in which Every Base Polynomial Splits\<close>

context Field
begin

text \<open>Zorn gave a maximal extension; maximality makes every polynomial over @{term R} split in it.
  Putting the two together is the whole of this step, exactly as it is in HOL-Algebra.\<close>
theorem exists_extension_with_roots:
  obtains M where "is_extension M"
    and "\<And>P. P \<in> poly_carrier
             \<Longrightarrow> Field.splits (ecarrier M) (eadd M) (emult M) \<zero>\<^sub>I \<one>\<^sub>I (lift_poly P)"
proof -
  obtain M where Mext: "M \<in> extensions"
    and Mmax: "\<forall>L \<in> extensions. ext_le M L \<longrightarrow> L = M"
    using exists_maximal_extension by blast
  have ext: "is_extension M" using Mext by simp
  interpret FE: field_extension R addition multiplication zero unit M
    by unfold_locales (rule ext)
  have max: "\<And>L. \<lbrakk> is_extension L; ext_le M L \<rbrakk> \<Longrightarrow> L = M"
    using Mmax by simp
  show thesis
  proof (rule that [OF ext])
    fix P assume P: "P \<in> poly_carrier"
    show "Field.splits (ecarrier M) (eadd M) (emult M) \<zero>\<^sub>I \<one>\<^sub>I (lift_poly P)"
      by (rule FE.exists_root [OF max P])
  qed
qed

end

