section \<open>Ideal Lattices, Extension, and Contraction\<close>

theory Ideal_Extension
  imports Ideal_Theory Order_Theory
begin

text \<open>The ideals of a commutative ring \<open>R\<close>, ordered by inclusion, form a complete lattice: the
  infimum of a family of ideals is their intersection (with \<open>R\<close>, so the empty family has infimum
  \<open>R\<close>), and the supremum is the ideal generated by their union.  Together with the subgroup lattice
  this exercises the abstract order theory on the two archetypal substructure lattices.  As a
  by-product we obtain the ideal \<^emph>\<open>generated by a set\<close>, the analogue of the subgroup \<open>generate\<close>.\<close>

context commutative_ring
begin

subsection \<open>Intersections of ideals\<close>

text \<open>The intersection of a nonempty family of ideals is an ideal.\<close>
lemma ideal_Inter:
  assumes ne: "\<A> \<noteq> {}" and id: "\<And>I. I \<in> \<A> \<Longrightarrow> Ideal I R (+) (\<cdot>) \<zero> \<one>"
  shows "Ideal (\<Inter> \<A>) R (+) (\<cdot>) \<zero> \<one>"
proof -
  obtain I0 where I0: "I0 \<in> \<A>" using ne by blast
  interpret I0: Ideal I0 R "(+)" "(\<cdot>)" \<zero> \<one> by (rule id[OF I0])
  have sg: "Subgroup (\<Inter> \<A>) R (+) \<zero>"
  proof (rule additive.subgroupI)
    show "\<Inter> \<A> \<subseteq> R" using I0 I0.additive.subset by blast
  next
    show "\<zero> \<in> \<Inter> \<A>"
    proof
      fix I assume "I \<in> \<A>"
      then interpret I: Ideal I R "(+)" "(\<cdot>)" \<zero> \<one> by (rule id)
      show "\<zero> \<in> I" by (rule I.additive.sub_unit_closed)
    qed
  next
    fix g h assume g: "g \<in> \<Inter> \<A>" and h: "h \<in> \<Inter> \<A>"
    show "g + h \<in> \<Inter> \<A>"
    proof
      fix I assume I: "I \<in> \<A>"
      then interpret I: Ideal I R "(+)" "(\<cdot>)" \<zero> \<one> by (rule id)
      show "g + h \<in> I" using g h I by (blast intro: I.additive.sub_composition_closed)
    qed
  next
    fix g assume "g \<in> \<Inter> \<A>"
    then have "g \<in> R" using I0 I0.additive.subset by blast
    then show "additive.invertible g" by simp
  next
    fix g assume g: "g \<in> \<Inter> \<A>"
    show "additive.inverse g \<in> \<Inter> \<A>"
    proof
      fix I assume I: "I \<in> \<A>"
      then interpret I: Ideal I R "(+)" "(\<cdot>)" \<zero> \<one> by (rule id)
      have "g \<in> I" using g I by blast
      then show "additive.inverse g \<in> I"
        using I.additive.submonoid_inverse_closed I.additive.sub.invertible by blast
    qed
  qed
  interpret S: Subgroup "\<Inter> \<A>" R "(+)" \<zero> by (rule sg)
  show ?thesis
  proof unfold_locales
    fix a b assume a: "a \<in> R" and b: "b \<in> \<Inter> \<A>"
    show "a \<cdot> b \<in> \<Inter> \<A>"
    proof
      fix I assume I: "I \<in> \<A>"
      then interpret I: Ideal I R "(+)" "(\<cdot>)" \<zero> \<one> by (rule id)
      show "a \<cdot> b \<in> I" using a b I by (blast intro: I.Ideal(1))
    qed
    show "b \<cdot> a \<in> \<Inter> \<A>"
    proof
      fix I assume I: "I \<in> \<A>"
      then interpret I: Ideal I R "(+)" "(\<cdot>)" \<zero> \<one> by (rule id)
      show "b \<cdot> a \<in> I" using a b I by (blast intro: I.Ideal(2))
    qed
  qed
qed


text \<open>The whole ring is an ideal of itself (the top of the ideal lattice).\<close>
lemma whole_ideal: "Ideal R R (+) (\<cdot>) \<zero> \<one>"
proof -
  have "Subgroup R R (+) \<zero>"
    by (rule additive.subgroupI) auto
  then interpret S: Subgroup R R "(+)" \<zero> .
  show ?thesis by unfold_locales auto
qed


subsection \<open>The ideal generated by a set\<close>

text \<open>The ideal generated by a subset \<open>S\<close> of the ring: the intersection of all ideals containing
  \<open>S \<inter> R\<close>.  (Intersecting with \<open>R\<close> in the guard mirrors the subgroup \<open>generate\<close>, so elements outside
  the carrier are ignored.)\<close>
definition ideal_generated :: "'a set \<Rightarrow> 'a set"
  where "ideal_generated S = \<Inter> {I. Ideal I R (+) (\<cdot>) \<zero> \<one> \<and> S \<inter> R \<subseteq> I}"

lemma ideal_generated_is_ideal: "Ideal (ideal_generated S) R (+) (\<cdot>) \<zero> \<one>"
proof -
  have "R \<in> {I. Ideal I R (+) (\<cdot>) \<zero> \<one> \<and> S \<inter> R \<subseteq> I}"
    using whole_ideal by auto
  then have ne: "{I. Ideal I R (+) (\<cdot>) \<zero> \<one> \<and> S \<inter> R \<subseteq> I} \<noteq> {}" by blast
  show ?thesis
    unfolding ideal_generated_def by (rule ideal_Inter[OF ne]) auto
qed

lemma ideal_generated_incl: "S \<inter> R \<subseteq> ideal_generated S"
  unfolding ideal_generated_def by blast

lemma ideal_generated_minimal:
  assumes "Ideal J R (+) (\<cdot>) \<zero> \<one>" "S \<inter> R \<subseteq> J"
  shows "ideal_generated S \<subseteq> J"
  unfolding ideal_generated_def using assms by (blast intro: Inter_lower)

lemma ideal_generated_subset_carrier: "ideal_generated S \<subseteq> R"
proof -
  interpret gen: Ideal "ideal_generated S" R "(+)" "(\<cdot>)" \<zero> \<one> by (rule ideal_generated_is_ideal)
  show ?thesis by (rule gen.additive.subset)
qed


subsection \<open>The product of two ideals\<close>

text \<open>The product \<open>I \<odot> J\<close> of two ideals is the ideal generated by all products \<open>i \<cdot> j\<close> with
  \<open>i \<in> I\<close> and \<open>j \<in> J\<close>.  Together with the ideal sum and the intersection this completes the
  semiring of ideals; the product is contained in the intersection (hence, unlike sum and
  intersection, is in general \<^emph>\<open>not\<close> a lattice operation).\<close>
definition ideal_prod :: "'a set \<Rightarrow> 'a set \<Rightarrow> 'a set"  (infixl \<open>\<odot>\<close> 70)
  where "I \<odot> J = ideal_generated {i \<cdot> j |i j. i \<in> I \<and> j \<in> J}"

lemma ideal_prod_is_ideal: "Ideal (I \<odot> J) R (+) (\<cdot>) \<zero> \<one>"
  unfolding ideal_prod_def by (rule ideal_generated_is_ideal)

lemma ideal_prod_subset_carrier: "I \<odot> J \<subseteq> R"
  unfolding ideal_prod_def by (rule ideal_generated_subset_carrier)

text \<open>Generators lie in the product.\<close>
lemma ideal_prod_memI:
  assumes I: "Ideal I R (+) (\<cdot>) \<zero> \<one>" and J: "Ideal J R (+) (\<cdot>) \<zero> \<one>"
    and i: "i \<in> I" and j: "j \<in> J"
  shows "i \<cdot> j \<in> I \<odot> J"
proof -
  interpret I: Ideal I R "(+)" "(\<cdot>)" \<zero> \<one> by (rule I)
  interpret J: Ideal J R "(+)" "(\<cdot>)" \<zero> \<one> by (rule J)
  have "i \<cdot> j \<in> R" using i j I.additive.subset J.additive.subset by blast
  moreover have "i \<cdot> j \<in> {i \<cdot> j |i j. i \<in> I \<and> j \<in> J}" using i j by blast
  ultimately have "i \<cdot> j \<in> {i \<cdot> j |i j. i \<in> I \<and> j \<in> J} \<inter> R" by blast
  also have "\<dots> \<subseteq> ideal_generated {i \<cdot> j |i j. i \<in> I \<and> j \<in> J}" by (rule ideal_generated_incl)
  finally show ?thesis unfolding ideal_prod_def .
qed

text \<open>The product is contained in both factors, hence in their intersection.\<close>
lemma ideal_prod_subset:
  assumes I: "Ideal I R (+) (\<cdot>) \<zero> \<one>" and J: "Ideal J R (+) (\<cdot>) \<zero> \<one>"
  shows "I \<odot> J \<subseteq> I \<inter> J"
proof -
  interpret I: Ideal I R "(+)" "(\<cdot>)" \<zero> \<one> by (rule I)
  interpret J: Ideal J R "(+)" "(\<cdot>)" \<zero> \<one> by (rule J)
  have gen: "{i \<cdot> j |i j. i \<in> I \<and> j \<in> J} \<inter> R \<subseteq> I \<inter> J"
  proof
    fix x assume "x \<in> {i \<cdot> j |i j. i \<in> I \<and> j \<in> J} \<inter> R"
    then obtain i j where x: "x = i \<cdot> j" and i: "i \<in> I" and j: "j \<in> J" by blast
    have "i \<cdot> j \<in> I" using i j J.additive.subset by (blast intro: I.Ideal(2))
    moreover have "i \<cdot> j \<in> J" using i j I.additive.subset by (blast intro: J.Ideal(1))
    ultimately show "x \<in> I \<inter> J" using x by simp
  qed
  have "Ideal (\<Inter> {I, J}) R (+) (\<cdot>) \<zero> \<one>"
    by (rule ideal_Inter) (use I J in auto)
  then have IJ: "Ideal (I \<inter> J) R (+) (\<cdot>) \<zero> \<one>" by simp
  show ?thesis
    unfolding ideal_prod_def by (rule ideal_generated_minimal[OF IJ]) (use gen in simp)
qed

text \<open>Commutativity: the generating sets coincide because the ring is commutative.\<close>
lemma ideal_prod_commute:
  assumes I: "Ideal I R (+) (\<cdot>) \<zero> \<one>" and J: "Ideal J R (+) (\<cdot>) \<zero> \<one>"
  shows "I \<odot> J = J \<odot> I"
proof -
  interpret I: Ideal I R "(+)" "(\<cdot>)" \<zero> \<one> by (rule I)
  interpret J: Ideal J R "(+)" "(\<cdot>)" \<zero> \<one> by (rule J)
  have "{i \<cdot> j |i j. i \<in> I \<and> j \<in> J} = {j \<cdot> i |i j. i \<in> I \<and> j \<in> J}"
    using I.additive.subset J.additive.subset by (blast intro: multiplicative.commutative)
  also have "\<dots> = {j \<cdot> i |j i. j \<in> J \<and> i \<in> I}" by blast
  finally show ?thesis unfolding ideal_prod_def by simp
qed


subsection \<open>The complete lattice of ideals\<close>

definition ideals :: "'a set set"
  where "ideals = {I. Ideal I R (+) (\<cdot>) \<zero> \<one>}"

lemma ideals_iff [simp]: "I \<in> ideals \<longleftrightarrow> Ideal I R (+) (\<cdot>) \<zero> \<one>"
  by (simp add: ideals_def)

interpretation ideal_order: Partial_Order ideals "(\<subseteq>)"
  by unfold_locales auto

interpretation ideal_lattice: Complete_Lattice ideals "(\<subseteq>)"
proof (unfold_locales)
  fix \<A> :: "'a set set" assume \<A>: "\<A> \<subseteq> ideals"
  \<comment> \<open>Supremum: the ideal generated by the union.\<close>
  let ?s = "ideal_generated (\<Union> \<A>)"
  have s_id: "Ideal ?s R (+) (\<cdot>) \<zero> \<one>" by (rule ideal_generated_is_ideal)
  have "ideal_order.is_sup ?s \<A>"
  proof (rule ideal_order.is_supI)
    show "ideal_order.upper_bound ?s \<A>"
    proof (rule ideal_order.upper_boundI)
      show "?s \<in> ideals" using s_id by simp
      fix I assume I: "I \<in> \<A>"
      then interpret I: Ideal I R "(+)" "(\<cdot>)" \<zero> \<one> using \<A> by auto
      have "I \<subseteq> \<Union> \<A> \<inter> R" using I I.additive.subset by blast
      then show "I \<subseteq> ?s" using ideal_generated_incl by blast
    qed
  next
    fix x assume "ideal_order.upper_bound x \<A>"
    then have xid: "Ideal x R (+) (\<cdot>) \<zero> \<one>" and dom: "\<And>I. I \<in> \<A> \<Longrightarrow> I \<subseteq> x"
      by (auto dest: ideal_order.upper_boundD simp: ideal_order.upper_bound_def)
    have "\<Union> \<A> \<inter> R \<subseteq> x"
    proof
      fix y assume "y \<in> \<Union> \<A> \<inter> R"
      then obtain I where "I \<in> \<A>" "y \<in> I" by blast
      then show "y \<in> x" using dom by blast
    qed
    then show "?s \<subseteq> x" using xid by (intro ideal_generated_minimal) auto
  qed
  then show "\<exists>s. ideal_order.is_sup s \<A>" ..
next
  fix \<A> :: "'a set set" assume \<A>: "\<A> \<subseteq> ideals"
  \<comment> \<open>Infimum: the intersection of \<open>\<A>\<close> together with \<open>R\<close>.\<close>
  let ?i = "\<Inter> (insert R \<A>)"
  have all_id: "\<And>I. I \<in> insert R \<A> \<Longrightarrow> Ideal I R (+) (\<cdot>) \<zero> \<one>"
    using \<A> whole_ideal by auto
  have i_id: "Ideal ?i R (+) (\<cdot>) \<zero> \<one>" by (rule ideal_Inter) (use all_id in auto)
  have "ideal_order.is_inf ?i \<A>"
  proof (rule ideal_order.is_infI)
    show "ideal_order.lower_bound ?i \<A>"
    proof (rule ideal_order.lower_boundI)
      show "?i \<in> ideals" using i_id by simp
      fix I assume "I \<in> \<A>" then show "?i \<subseteq> I" by blast
    qed
  next
    fix x assume "ideal_order.lower_bound x \<A>"
    then have xid: "Ideal x R (+) (\<cdot>) \<zero> \<one>" and dom: "\<And>I. I \<in> \<A> \<Longrightarrow> x \<subseteq> I"
      by (auto dest: ideal_order.lower_boundD simp: ideal_order.lower_bound_def)
    interpret x: Ideal x R "(+)" "(\<cdot>)" \<zero> \<one> by (rule xid)
    show "x \<subseteq> ?i" using dom x.additive.subset by blast
  qed
  then show "\<exists>i. ideal_order.is_inf i \<A>" ..
qed

end

subsection \<open>Extension and contraction\<close>

text \<open>Along a homomorphism @{term \<eta>} of commutative rings @{text "R \<rightarrow> R'"} there are two natural
  operations on ideals:

    \<^item> \<^emph>\<open>contraction\<close> @{text "J \<mapsto> \<eta> -` J \<inter> R"}, the preimage of an ideal of the target, which is
      always an ideal of the source;

    \<^item> \<^emph>\<open>extension\<close> @{text "I \<mapsto> \<langle>\<eta> ` I\<rangle>"}, the ideal of the target \<^emph>\<open>generated by\<close> the image of an
      ideal of the source.  Generation is needed: the direct image @{term "\<eta> ` I"} need not be an
      ideal of @{term R'} --- it is closed under addition and under multiplication by elements of
      @{term "\<eta> ` R"}, but not in general by arbitrary elements of @{term R'}.  (For the inclusion of the integers in the rationals, the image of the even integers is
      not an ideal of the rationals.)

  These form an \<^emph>\<open>adjoint pair\<close> between the ideal lattices, ordered by inclusion:
  @{text "\<langle>\<eta> ` I\<rangle> \<subseteq> J \<longleftrightarrow> I \<subseteq> \<eta> -` J \<inter> R"}.  So this is a genuine instance of the
  @{locale Galois_Connection} locale of \<open>Order_Theory\<close>, and all of its consequences --- the unit and
  counit inequalities, monotonicity of both adjoints, the semi-inverse identities, and idempotence of
  the induced closure and kernel operators --- come for free.

  The two rings are commutative because \<open>ideal_generated\<close> and \<open>ideals\<close> are defined in
  the \<open>commutative_ring\<close> context.  As with the module homomorphism locale, the target ring's
  operations are written with primes and the source's unprimed; the two rings are \<^emph>\<open>separate\<close> here
  (unlike the shared scalar ring of a module homomorphism), so no parameter is shared.\<close>

locale comm_ring_homomorphism = ring_homomorphism +
  source: commutative_ring R "(+)" "(\<cdot>)" \<zero> \<one> +
  target: commutative_ring R' "(+')" "(\<cdot>')" "\<zero>'" "\<one>'"
begin

subsection \<open>Contraction: the preimage of an ideal\<close>

text \<open>The contraction of a subset of the target: its preimage, cut down to the source carrier.\<close>
definition contract :: "'b set \<Rightarrow> 'a set"
  where "contract J = \<eta> -` J \<inter> R"

lemma contract_subset: "contract J \<subseteq> R"
  by (auto simp: contract_def)

lemma contract_memI: "\<lbrakk> a \<in> R; \<eta> a \<in> J \<rbrakk> \<Longrightarrow> a \<in> contract J"
  by (simp add: contract_def)

lemma contract_memD: "a \<in> contract J \<Longrightarrow> a \<in> R \<and> \<eta> a \<in> J"
  by (simp add: contract_def)

lemma contract_mono: "J \<subseteq> J' \<Longrightarrow> contract J \<subseteq> contract J'"
  by (auto simp: contract_def)

text \<open>The preimage of an ideal is an ideal: it contains the zero because \<open>\<eta>\<close> preserves it, is closed
  under addition and negation because \<open>\<eta>\<close> is additive, and absorbs multiplication because \<open>\<eta>\<close> is
  multiplicative and \<open>J\<close> absorbs multiplication in the target.\<close>
theorem contract_ideal:
  assumes J: "Ideal J R' (+') (\<cdot>') \<zero>' \<one>'"
  shows "Ideal (contract J) R (+) (\<cdot>) \<zero> \<one>"
proof -
  interpret J: Ideal J R' "(+')" "(\<cdot>')" "\<zero>'" "\<one>'" by (rule J)
  \<comment> \<open>@{term \<eta>} carries the additive inverse to the additive inverse.  This is
    @{thm [source] Monoid_homomorphism.invertible_commutes_with_inverse} for the additive
    homomorphism; its \<open>invertible\<close> hypothesis is discharged automatically because the additive
    monoid of a ring is a group.\<close>
  have hom_neg: "\<eta> (source.additive.inverse a) = target.additive.inverse (\<eta> a)" if a: "a \<in> R" for a
    using a by (simp add: additive.invertible_commutes_with_inverse)
  \<comment> \<open>The preimage is an additive subgroup ...\<close>
  have "Subgroup (contract J) R (+) \<zero>"
  proof (rule source.additive.subgroupI)
    show "contract J \<subseteq> R" by (rule contract_subset)
    show "\<zero> \<in> contract J"
      by (rule contract_memI) (simp_all add: additive.commutes_with_unit J.additive.sub_unit_closed)
    show "\<And>g h. \<lbrakk> g \<in> contract J; h \<in> contract J \<rbrakk> \<Longrightarrow> g + h \<in> contract J"
    proof -
      fix g h assume "g \<in> contract J" and "h \<in> contract J"
      then have gR: "g \<in> R" and hR: "h \<in> R" and hg: "\<eta> g \<in> J" and hh: "\<eta> h \<in> J"
        by (auto dest: contract_memD)
      have "\<eta> (g + h) = \<eta> g +' \<eta> h"
        using gR hR by (simp add: additive.commutes_with_composition)
      then show "g + h \<in> contract J"
        using gR hR hg hh by (auto intro!: contract_memI J.additive.sub_composition_closed)
    qed
    show "\<And>g. g \<in> contract J \<Longrightarrow> source.additive.invertible g"
      using contract_subset by auto
    show "\<And>g. g \<in> contract J \<Longrightarrow> source.additive.inverse g \<in> contract J"
    proof -
      fix g assume "g \<in> contract J"
      then have gR: "g \<in> R" and hg: "\<eta> g \<in> J" by (auto dest: contract_memD)
      have "\<eta> (source.additive.inverse g) = target.additive.inverse (\<eta> g)"
        using gR by (rule hom_neg)
      moreover have "target.additive.inverse (\<eta> g) \<in> J"
        using hg J.additive.sub.invertible by (simp add: J.additive.submonoid_inverse_closed)
      ultimately show "source.additive.inverse g \<in> contract J"
        using gR by (auto intro!: contract_memI)
    qed
  qed
  then interpret S: Subgroup "contract J" R "(+)" \<zero> .
  \<comment> \<open>... and it absorbs multiplication from either side.\<close>
  show ?thesis
  proof unfold_locales
    fix a b assume a: "a \<in> R" and b: "b \<in> contract J"
    then have bR: "b \<in> R" and hb: "\<eta> b \<in> J" by (auto dest: contract_memD)
    have "\<eta> (a \<cdot> b) = \<eta> a \<cdot>' \<eta> b"
      using a bR by (simp add: multiplicative.commutes_with_composition)
    also have "\<dots> \<in> J" using a hb by (blast intro: J.Ideal(1))
    finally show "a \<cdot> b \<in> contract J" using a bR by (blast intro: contract_memI)
  next
    fix a b assume a: "a \<in> R" and b: "b \<in> contract J"
    then have bR: "b \<in> R" and hb: "\<eta> b \<in> J" by (auto dest: contract_memD)
    have "\<eta> (b \<cdot> a) = \<eta> b \<cdot>' \<eta> a"
      using a bR by (simp add: multiplicative.commutes_with_composition)
    also have "\<dots> \<in> J" using a hb by (blast intro: J.Ideal(2))
    finally show "b \<cdot> a \<in> contract J" using a bR by (blast intro: contract_memI)
  qed
qed

text \<open>The contraction of the target's zero ideal is the kernel; contracting the whole target gives
  the whole source.\<close>
lemma contract_whole: "contract R' = R"
  using map_closed by (auto simp: contract_def)


subsection \<open>Extension: the ideal generated by the image\<close>

text \<open>The extension of a subset of the source: the ideal of the target generated by its image.\<close>
definition extend :: "'a set \<Rightarrow> 'b set"
  where "extend I = target.ideal_generated (\<eta> ` I)"

lemma extend_ideal: "Ideal (extend I) R' (+') (\<cdot>') \<zero>' \<one>'"
  unfolding extend_def by (rule target.ideal_generated_is_ideal)

lemma extend_subset: "extend I \<subseteq> R'"
  unfolding extend_def by (rule target.ideal_generated_subset_carrier)

text \<open>The image lands inside the extension.  Note the intersection with @{term R'} in
  @{thm [source] target.ideal_generated_incl} is harmless: the image of a subset of @{term R} already
  lies in @{term R'}.\<close>
lemma extend_incl:
  assumes I: "I \<subseteq> R" shows "\<eta> ` I \<subseteq> extend I"
proof -
  have "\<eta> ` I \<subseteq> R'" using I map_closed by blast
  then have "\<eta> ` I \<inter> R' = \<eta> ` I" by blast
  then show ?thesis
    unfolding extend_def using target.ideal_generated_incl[of "\<eta> ` I"] by simp
qed

text \<open>Extension is minimal: any target ideal containing the image contains the extension.\<close>
lemma extend_minimal:
  assumes J: "Ideal J R' (+') (\<cdot>') \<zero>' \<one>'" and sub: "\<eta> ` I \<subseteq> J"
  shows "extend I \<subseteq> J"
  unfolding extend_def
proof (rule target.ideal_generated_minimal[OF J])
  show "\<eta> ` I \<inter> R' \<subseteq> J" using sub by blast
qed

lemma extend_mono:
  assumes II': "I \<subseteq> I'" and I': "I' \<subseteq> R" shows "extend I \<subseteq> extend I'"
proof (rule extend_minimal[OF extend_ideal])
  show "\<eta> ` I \<subseteq> extend I'" using II' extend_incl[OF I'] by blast
qed


subsection \<open>The adjunction\<close>

text \<open>\<^emph>\<open>Extension is left adjoint to contraction.\<close>  Both directions are immediate from minimality of
  the generated ideal and the definition of preimage --- which is exactly why extension had to be
  defined by generation: without it the left-to-right direction would fail.\<close>
theorem extend_contract_galois:
  assumes I: "I \<subseteq> R" and J: "Ideal J R' (+') (\<cdot>') \<zero>' \<one>'"
  shows "extend I \<subseteq> J \<longleftrightarrow> I \<subseteq> contract J"
proof
  assume "extend I \<subseteq> J"
  with extend_incl[OF I] have "\<eta> ` I \<subseteq> J" by blast
  then show "I \<subseteq> contract J" using I by (auto intro: contract_memI)
next
  assume "I \<subseteq> contract J"
  then have "\<eta> ` I \<subseteq> J" by (auto dest: contract_memD)
  then show "extend I \<subseteq> J" by (rule extend_minimal[OF J])
qed

text \<open>\<^emph>\<open>The Galois connection.\<close>  On the ideal lattices of the two rings, ordered by inclusion,
  extension and contraction form an adjoint pair.  Interpreting @{locale Galois_Connection} makes its
  whole development available: @{text unit} (@{text "I \<subseteq> contract (extend I)"}), @{text counit}
  (@{text "extend (contract J) \<subseteq> J"}), isotonicity of both maps, the semi-inverse laws
  @{text "extend (contract (extend I)) = extend I"} and
  @{text "contract (extend (contract J)) = contract J"}, and idempotence of the closure
  @{text "contract \<circ> extend"} and kernel @{text "extend \<circ> contract"}.\<close>
theorem ideal_galois_connection:
  "Galois_Connection source.ideals (\<subseteq>) target.ideals (\<subseteq>) extend contract"
proof (rule Galois_Connection.intro)
  \<comment> \<open>Inclusion is a partial order on any set of sets; the ideal-lattice interpretation above is
    inside its \<open>commutative_ring\<close> context and so is not citable by name from here.\<close>
  show "Partial_Order source.ideals (\<subseteq>)" by unfold_locales auto
  show "Partial_Order target.ideals (\<subseteq>)" by unfold_locales auto
  show "Galois_Connection_axioms source.ideals (\<subseteq>) target.ideals (\<subseteq>) extend contract"
  proof
    show "extend \<in> source.ideals \<rightarrow> target.ideals"
      using extend_ideal by (auto simp: target.ideals_iff)
    show "contract \<in> target.ideals \<rightarrow> source.ideals"
      using contract_ideal by (auto simp: source.ideals_iff target.ideals_iff)
    fix I J assume "I \<in> source.ideals" and "J \<in> target.ideals"
    then have I: "Ideal I R (+) (\<cdot>) \<zero> \<one>" and J: "Ideal J R' (+') (\<cdot>') \<zero>' \<one>'"
      by (simp_all add: source.ideals_iff target.ideals_iff)
    interpret I: Ideal I R "(+)" "(\<cdot>)" \<zero> \<one> by (rule I)
    have IR: "I \<subseteq> R" by (rule I.additive.subset)
    show "extend I \<subseteq> J \<longleftrightarrow> I \<subseteq> contract J" by (rule extend_contract_galois[OF IR J])
  qed
qed

text \<open>The consequences of the adjunction, specialised to ideals.  These are obtained by interpreting
  @{thm [source] ideal_galois_connection} locally rather than by a @{command sublocale} declaration:
  a \<open>sublocale galois_connection\<close> inside this locale sends the interpretation machinery into a loop,
  because @{locale comm_ring_homomorphism} would then be a source of \<open>galois_connection\<close> facts about
  its own ideal lattices while still being elaborated.  The theorem form has no such problem, and
  consumers can \<^theory_text>\<open>interpret\<close> it wherever they need the full development.\<close>

context
begin

interpretation GC: Galois_Connection
  "source.ideals" "(\<subseteq>)" "target.ideals" "(\<subseteq>)" extend contract
  by (rule ideal_galois_connection)

text \<open>\<^emph>\<open>Unit\<close>: an ideal is contained in the contraction of its extension.\<close>
corollary contract_extend_incl:
  "Ideal I R (+) (\<cdot>) \<zero> \<one> \<Longrightarrow> I \<subseteq> contract (extend I)"
  using GC.unit by simp

text \<open>\<^emph>\<open>Counit\<close>: the extension of a contraction is contained in the original ideal.  The inclusion is
  in general strict --- for @{text "\<int> \<subseteq> \<rat>"} every nonzero ideal of @{text \<rat>} contracts to a
  nonzero ideal of @{text \<int>} whose extension is all of @{text \<rat>}.\<close>
corollary extend_contract_subset:
  "Ideal J R' (+') (\<cdot>') \<zero>' \<one>' \<Longrightarrow> extend (contract J) \<subseteq> J"
  using GC.counit by simp

text \<open>Both adjoints are isotone on ideals.\<close>
corollary extend_mono_ideal:
  "\<lbrakk> Ideal I R (+) (\<cdot>) \<zero> \<one>; Ideal I' R (+) (\<cdot>) \<zero> \<one>; I \<subseteq> I' \<rbrakk> \<Longrightarrow> extend I \<subseteq> extend I'"
  using isotone_le[OF GC.lower_isotone] by simp

corollary contract_mono_ideal:
  "\<lbrakk> Ideal J R' (+') (\<cdot>') \<zero>' \<one>'; Ideal J' R' (+') (\<cdot>') \<zero>' \<one>'; J \<subseteq> J' \<rbrakk>
   \<Longrightarrow> contract J \<subseteq> contract J'"
  using isotone_le[OF GC.upper_isotone] by simp

text \<open>The \<^emph>\<open>semi-inverse\<close> laws: extension and contraction are mutually inverse up to one round trip.\<close>
corollary extend_contract_extend:
  "Ideal I R (+) (\<cdot>) \<zero> \<one> \<Longrightarrow> extend (contract (extend I)) = extend I"
  using GC.lower_semi_inverse by simp

corollary contract_extend_contract:
  "Ideal J R' (+') (\<cdot>') \<zero>' \<one>' \<Longrightarrow> contract (extend (contract J)) = contract J"
  using GC.upper_semi_inverse by simp

text \<open>Hence @{text "contract \<circ> extend"} is a closure operator on the ideals of the source, and
  @{text "extend \<circ> contract"} a kernel operator on those of the target.\<close>
corollary closure_idempotent:
  "Ideal I R (+) (\<cdot>) \<zero> \<one> \<Longrightarrow> contract (extend (contract (extend I))) = contract (extend I)"
  using GC.closure_idempotent by simp

corollary kernel_idempotent:
  "Ideal J R' (+') (\<cdot>') \<zero>' \<one>' \<Longrightarrow> extend (contract (extend (contract J))) = extend (contract J)"
  using GC.kernel_idempotent by simp

end

end (* comm_ring_homomorphism *)

end
