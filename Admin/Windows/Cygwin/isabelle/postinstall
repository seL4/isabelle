#!/bin/bash

export PATH=/bin

bash /etc/postinstall/base-files-mketc.sh.done

mkpasswd -l -u "$USERNAME" -p "$(cygpath -u "$HOMEDRIVE$HOMEPATH\\..")" >/etc/passwd

gzip -dc /isabelle/permissions/directories.gz | xargs -0 setfacl -m default:user::rwx,default:group::r-x,default:other:r-x
gzip -dc /isabelle/permissions/directories.gz | xargs -0 chmod 755
gzip -dc /isabelle/permissions/755.gz | xargs -0 chmod 755
gzip -dc /isabelle/permissions/644.gz | xargs -0 chmod 644
gzip -dc /isabelle/permissions/444.gz | xargs -0 chmod 444
